diff --git a/src/ok_env.c b/src/ok_env.c
new file mode 100644
index 0000000..6e79833
--- /dev/null
+++ b/src/ok_env.c
@@ -0,0 +1,77 @@
+#include "ok_posix.h" // FIRST: the deliberate POSIX opt-in (see its header)
+
+#include "ok_env.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+// POSIX. glibc and friends expose it; a host without it owns the layer
+// rewrite (the same stance okdylib takes with its platform tables).
+extern char** environ;
+
+const char* ok_env_get(const char* p_name) {
+  return getenv(p_name);
+}
+
+bool ok_env_set(const char* p_name, const char* p_value) {
+  return setenv(p_name, p_value, 1) == 0;
+}
+
+bool ok_env_unset(const char* p_name) {
+  return unsetenv(p_name) == 0;
+}
+
+static int ok_env_list_cmp(const void* p_a, const void* p_b) {
+  const char* const* a = (const char* const*)p_a;
+  const char* const* b = (const char* const*)p_b;
+  return strcmp(*a, *b);
+}
+
+bool ok_env_list(const ok_allocators* p_alloc, char*** p_out_names, uint32_t* p_out_count) {
+  char** names = NULL;
+  uint32_t count = 0;
+  uint32_t capacity = 0;
+  for (char** entry = environ; entry != NULL && *entry != NULL; ++entry) {
+    const char* equals = strchr(*entry, '=');
+    const size_t length = equals != NULL ? (size_t)(equals - *entry) : strlen(*entry);
+    if (count == capacity) {
+      const uint32_t grown = capacity == 0 ? 16 : capacity * 2;
+      char** moved = (char**)p_alloc->reallocate(names, (size_t)grown * sizeof(char*));
+      if (moved == NULL) {
+        goto fail;
+      }
+      names = moved;
+      capacity = grown;
+    }
+    char* copy = (char*)p_alloc->allocate(length + 1);
+    if (copy == NULL) {
+      goto fail;
+    }
+    memcpy(copy, *entry, length);
+    copy[length] = '\0';
+    names[count++] = copy;
+  }
+  if (count > 1) {
+    qsort(names, count, sizeof(char*), ok_env_list_cmp);
+  }
+  // dedupe adjacent twins (a repeated name is legal in environ; the
+  // first-in-sort-order survives, the walk keeps one of each)
+  uint32_t unique = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    if (unique > 0 && strcmp(names[unique - 1], names[i]) == 0) {
+      p_alloc->release(names[i]);
+      continue;
+    }
+    names[unique++] = names[i];
+  }
+  *p_out_names = names;
+  *p_out_count = unique;
+  return true;
+
+fail:
+  for (uint32_t i = 0; i < count; ++i) {
+    p_alloc->release(names[i]);
+  }
+  p_alloc->release(names);
+  return false;
+}
diff --git a/src/ok_env.h b/src/ok_env.h
new file mode 100644
index 0000000..c7883fd
--- /dev/null
+++ b/src/ok_env.h
@@ -0,0 +1,29 @@
+#ifndef OK_ENV_H
+#define OK_ENV_H
+
+// ok_env: the environment door (the P4 audit). libok's own OKPATH read
+// and std.sys's env surface ride these, and nothing else in the library
+// touches the environment. get() answers the borrowed live entry (the
+// libc contract - copy it before mutating); set/unset take effect in the
+// process environment the host gave ok.
+
+#include <ok/ok.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+
+// the entry's value, or NULL when the name is unset. borrowed.
+const char* ok_env_get(const char* p_name);
+
+// false on an invalid name (embedded '=' or NUL - EINVAL's lanes).
+bool ok_env_set(const char* p_name, const char* p_value);
+
+// idempotent: unsetting an unset name succeeds.
+bool ok_env_unset(const char* p_name);
+
+// the environment's names, sorted by strcmp, deduped (the determinism
+// rule). each name and the array itself come from p_alloc; the caller
+// releases them all.
+bool ok_env_list(const ok_allocators* p_alloc, char*** p_out_names, uint32_t* p_out_count);
+
+#endif // OK_ENV_H
diff --git a/src/ok_fs.c b/src/ok_fs.c
new file mode 100644
index 0000000..501e23e
--- /dev/null
+++ b/src/ok_fs.c
@@ -0,0 +1,152 @@
+#include "ok_posix.h" // FIRST: the deliberate POSIX opt-in (see its header)
+
+#include "ok_fs.h"
+
+#include <dirent.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+// the 1 GiB read cap. a bigger "file" is either real (bring a streaming
+// api when one exists) or ftell lying about a special node - both refuse.
+#define OK_FS_MAX_READ (1u << 30)
+
+bool ok_fs_read_file(const char* p_path, const ok_allocators* p_alloc, ok_fs_buffer* p_out) {
+  // a regular file only: fopen alone happily "opens" a directory on
+  // linux, and ftell then answers a garbage-huge size (the allocation
+  // blast asan caught once already). the probe contract needs the read
+  // to fail for anything that is not a file.
+  struct stat info;
+  if (stat(p_path, &info) != 0 || !S_ISREG(info.st_mode)) {
+    return false;
+  }
+  FILE* file = fopen(p_path, "rb");
+  if (file == NULL) {
+    return false;
+  }
+  if (fseek(file, 0L, SEEK_END) != 0) {
+    fclose(file);
+    return false;
+  }
+  const long size = ftell(file);
+  rewind(file);
+  if (size < 0 || (unsigned long)size > OK_FS_MAX_READ) {
+    // unreadable or absurd: refuse rather than trust ftell on exotic nodes
+    fclose(file);
+    return false;
+  }
+  char* buff = (char*)p_alloc->allocate((size_t)size + 1);
+  if (buff == NULL) {
+    fclose(file);
+    return false;
+  }
+  const size_t read = fread(buff, sizeof(char), (size_t)size, file);
+  fclose(file);
+  if (read != (size_t)size) {
+    p_alloc->release(buff);
+    return false;
+  }
+  buff[read] = '\0';
+  p_out->chars = buff;
+  p_out->length = (uint64_t)read;
+  return true;
+}
+
+bool ok_fs_write_file(const char* p_path, const char* p_data, uint64_t p_length, bool p_append) {
+  FILE* file = fopen(p_path, p_append ? "ab" : "wb");
+  if (file == NULL) {
+    return false;
+  }
+  const size_t written = p_length > 0 ? fwrite(p_data, sizeof(char), (size_t)p_length, file) : 0;
+  const bool ok = written == (size_t)p_length && fflush(file) == 0;
+  fclose(file);
+  return ok;
+}
+
+bool ok_fs_exists(const char* p_path) {
+  struct stat info;
+  return stat(p_path, &info) == 0;
+}
+
+bool ok_fs_is_file(const char* p_path) {
+  struct stat info;
+  return stat(p_path, &info) == 0 && S_ISREG(info.st_mode);
+}
+
+bool ok_fs_is_dir(const char* p_path) {
+  struct stat info;
+  return stat(p_path, &info) == 0 && S_ISDIR(info.st_mode);
+}
+
+bool ok_fs_remove(const char* p_path) {
+  if (unlink(p_path) == 0) {
+    return true;
+  }
+  return rmdir(p_path) == 0;
+}
+
+bool ok_fs_mkdir(const char* p_path) {
+  return mkdir(p_path, 0777) == 0;
+}
+
+static int ok_fs_list_cmp(const void* p_a, const void* p_b) {
+  const char* const* a = (const char* const*)p_a;
+  const char* const* b = (const char* const*)p_b;
+  return strcmp(*a, *b);
+}
+
+bool ok_fs_list(const char* p_path, const ok_allocators* p_alloc, char*** p_out_names, uint32_t* p_out_count) {
+  DIR* dir = opendir(p_path);
+  if (dir == NULL) {
+    return false;
+  }
+  char** names = NULL;
+  uint32_t count = 0;
+  uint32_t capacity = 0;
+  bool ok = true;
+  const struct dirent* entry;
+  while ((entry = readdir(dir)) != NULL) {
+    const char* name = entry->d_name;
+    if (name[0] == '.' && (name[1] == '\0' || (name[1] == '.' && name[2] == '\0'))) {
+      continue; // "." and ".." are structure, not entries
+    }
+    if (count == capacity) {
+      const uint32_t grown = capacity == 0 ? 8 : capacity * 2;
+      char** moved = (char**)p_alloc->reallocate(names, (size_t)grown * sizeof(char*));
+      if (moved == NULL) {
+        ok = false;
+        break;
+      }
+      names = moved;
+      capacity = grown;
+    }
+    const size_t length = strlen(name);
+    char* copy = (char*)p_alloc->allocate(length + 1);
+    if (copy == NULL) {
+      ok = false;
+      break;
+    }
+    memcpy(copy, name, length + 1);
+    names[count++] = copy;
+  }
+  closedir(dir);
+  if (ok) {
+    if (count > 1) {
+      qsort(names, count, sizeof(char*), ok_fs_list_cmp);
+    }
+    *p_out_names = names;
+    *p_out_count = count;
+    return true;
+  }
+  for (uint32_t i = 0; i < count; ++i) {
+    p_alloc->release(names[i]);
+  }
+  p_alloc->release(names);
+  return false;
+}
+
+bool ok_fs_cwd(char* p_buffer, size_t p_capacity) {
+  return getcwd(p_buffer, p_capacity) != NULL;
+}
diff --git a/src/ok_fs.h b/src/ok_fs.h
new file mode 100644
index 0000000..f0a3035
--- /dev/null
+++ b/src/ok_fs.h
@@ -0,0 +1,60 @@
+#ifndef OK_FS_H
+#define OK_FS_H
+
+// ok_fs: the ONE door libok's file and directory host calls go through
+// (the P4 audit). everything else in the library reaches the filesystem
+// through these functions - the module loader's source reads, the dylib
+// probe, std.fs - so an embedder auditing the library reads one file to
+// know every byte ok touches on disk. the CLI keeps its own POSIX lane
+// per its ruling; embedders own their own host code.
+//
+// buffers come from the caller's raw allocators (no gc - these are
+// plain byte buffers, never object roots). every path is a C string; the
+// natives above this layer are responsible for rejecting embedded NULs
+// before they get here.
+
+#include <ok/ok.h>
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+typedef struct {
+  char* chars;     // p_alloc's allocate; NUL-terminated for tooling
+  uint64_t length; // bytes read (the NUL is not counted)
+} ok_fs_buffer;
+
+// whole-file read of a REGULAR file. false for anything else: missing,
+// unreadable, a directory (fopen happily "opens" those on linux - the
+// probe contract refuses), a special node, or absurd size (the 1 GiB
+// cap: ftell on exotic nodes answers garbage-huge, and the module lane
+// learned that the hard way). the buffer is the caller's to release.
+bool ok_fs_read_file(const char* p_path, const ok_allocators* p_alloc, ok_fs_buffer* p_out);
+
+// whole-file write. p_append selects the append mode over the truncate
+// mode; both create the file when missing. one fwrite, checked: a short
+// write is a failure, not a warning.
+bool ok_fs_write_file(const char* p_path, const char* p_data, uint64_t p_length, bool p_append);
+
+bool ok_fs_exists(const char* p_path);
+bool ok_fs_is_file(const char* p_path); // a regular file
+bool ok_fs_is_dir(const char* p_path);  // a directory (not a symlink to one - stat, not lstat)
+
+// unlink first, rmdir second: a file, or an EMPTY directory, dies; a
+// non-empty directory refuses (rmdir's own semantics - the safe shape,
+// no recursive deletes exist at this layer, ever).
+bool ok_fs_remove(const char* p_path);
+
+// one level, no parents created. 0777 before umask.
+bool ok_fs_mkdir(const char* p_path);
+
+// the directory's entry names, sorted by strcmp (the determinism rule),
+// "." and ".." excluded. each name and the array itself come from
+// p_alloc; the caller releases them all.
+bool ok_fs_list(const char* p_path, const ok_allocators* p_alloc, char*** p_out_names, uint32_t* p_out_count);
+
+// the process working directory. false when it is unreadable or does
+// not fit p_capacity.
+bool ok_fs_cwd(char* p_buffer, size_t p_capacity);
+
+#endif // OK_FS_H
diff --git a/src/ok_posix.h b/src/ok_posix.h
new file mode 100644
index 0000000..fb424bc
--- /dev/null
+++ b/src/ok_posix.h
@@ -0,0 +1,16 @@
+#ifndef OK_POSIX_H
+#define OK_POSIX_H
+
+// the one place libok opts into POSIX (the P4 audit's ask: "all host stuff
+// are behind abstractions"). libok compiles c99-strict; every translation
+// unit that needs a POSIX surface includes this FIRST, so the opt-in is
+// deliberate, per-layer, and visible in one file. anything not included
+// here stays ISO C by construction - the audit greps for that.
+//
+// 200809L covers the whole list the layers use: stat, opendir/readdir,
+// unlink/rmdir/mkdir/getcwd, environ, setenv/unsetenv, clock_gettime,
+// realpath, dlopen. the CLI keeps its own lane (its ruling: strictly
+// POSIX is acceptable there) and does not include this file.
+#define _POSIX_C_SOURCE 200809L
+
+#endif // OK_POSIX_H
diff --git a/src/ok_time.c b/src/ok_time.c
new file mode 100644
index 0000000..d72770e
--- /dev/null
+++ b/src/ok_time.c
@@ -0,0 +1,23 @@
+#include "ok_posix.h" // FIRST: the deliberate POSIX opt-in (see its header)
+
+#include "ok_time.h"
+
+#include <time.h>
+
+void ok_time_wall(double* p_out) {
+  struct timespec ts;
+  if (clock_gettime(CLOCK_REALTIME, &ts) != 0) {
+    *p_out = 0.0; // unreachable on a conforming POSIX 2008 host; defensive
+    return;
+  }
+  *p_out = (double)ts.tv_sec + (double)ts.tv_nsec / 1.0e9;
+}
+
+void ok_time_monotonic(double* p_out) {
+  struct timespec ts;
