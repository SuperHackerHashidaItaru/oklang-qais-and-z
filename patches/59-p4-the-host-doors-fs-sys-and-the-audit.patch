       fprintf(stderr, "runtime error occurred.\n");
     } else if (result == OK_INIT_ERROR) {
       fprintf(stderr, "init error occurred.\n");
+    } else if (result == OK_EXITED) {
+      // the script asked to stop (std.sys's exit): the process answers with
