diff --git a/src/ok.c b/src/ok.c
index b1acd99..56bea07 100644
--- a/src/ok.c
+++ b/src/ok.c
@@ -8,6 +8,8 @@
 #include "ok/ok_module.h"
 #include "okcompiler.h"
