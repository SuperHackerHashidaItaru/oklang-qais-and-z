+                        "invalid argument: 'codepoints' expects a string.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+    return NULL_AS_VALUE();
+  }
+  const object_string* str = VALUE_AS_STRING(p_argv[0]);
+  return NUMBER_AS_VALUE((double)str->codepoints);
+}
