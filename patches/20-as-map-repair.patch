     }
     break;
   }
+  case TT_MAP: {
+    // a checked identity, not a conversion: nothing sensibly converts to a map.
+    // this is the doc's type check (`m as map`), the bridge to 0.5.0's real types.
+    if (IS_VALUE_MAP(p_lhs)) {
+      *dest = p_lhs;
+      res.status = RUNTIME_OK;
