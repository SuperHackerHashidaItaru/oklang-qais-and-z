+    reg->array.data[at] = NULL_AS_VALUE(); // consumed: exactly once per scope instance
     const uint32_t depth = exe->call_stack.count;
     const uint32_t saved_top = reg->top;
-    if (!stage_defer_thunk(p_vm, exe, reg, thunk)) {
-      reg->top = saved_top;
-      if (!exe->error_hard) {
