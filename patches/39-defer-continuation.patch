+      }
+      exe->yield_barrier++;
+      const interpret_result result = run_until(p_vm, depth);
+      exe->yield_barrier = saved_barrier;
+      if (result.status == RUNTIME_OK) {
+        // the thunk survived (its own catches, if any, consumed their errors):
