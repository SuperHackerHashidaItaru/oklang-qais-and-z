+    return false;
+  }
+  const ok_native_module* descriptor = NULL;
+  void* handle = NULL;
+  char err[256];
+  err[0] = '\0';
+  if (!modules->loader.load_native(modules->loader.p_ctx, p_path, ok_api_table(), &descriptor, &handle, err,
+                                   sizeof(err))) {
+    if (err[0] != '\0') {
