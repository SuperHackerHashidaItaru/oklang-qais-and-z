+    } else if (path == NULL) {
+      path = arg;
+    } else {
+      bad = true;
+      break;
+    }
+  }
+
+  if (bad) {
+    usage();
+    return 64;
+  }
+
   ok* ok = ok_create(specs);
-  if (argc == 1) {
