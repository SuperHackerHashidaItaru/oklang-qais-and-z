+  ast_statement_init(&p_for_numeric->statement, AST_FOR_NUMERIC_STATEMENT, p_token, p_specs);
+  p_for_numeric->binding = NULL;
+  p_for_numeric->start = NULL;
+  p_for_numeric->limit = NULL;
