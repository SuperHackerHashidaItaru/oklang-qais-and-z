+
+print a.count(); // expect: 10
+print a.bump(); // expect: 13
+print a.bump(); // expect: 16
+print b.count(); // expect: 0
+print a.count(); // expect: 16
+print a.step(); // expect: 3
+print b.bump(); // expect: 3
+
