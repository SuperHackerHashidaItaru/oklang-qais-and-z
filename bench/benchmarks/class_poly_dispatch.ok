class Cat { pub fu speak() { return 1; } }
class Dog { pub fu speak() { return 2; } }
let cat = Cat();
let dog = Dog();
let mut i = 0;
let mut sum = 0;
let mut flag = true;
while i < 5000000 {
  if flag {
    sum = sum + cat.speak();
    flag = false;
  } else {
    sum = sum + dog.speak();
    flag = true;
  }
  i = i + 1;
}
print sum;
