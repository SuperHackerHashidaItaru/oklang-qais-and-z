diff --git a/tests/e2e/tests/modules/pubmembers/lib.ok b/tests/e2e/tests/modules/pubmembers/lib.ok
new file mode 100644
index 0000000..2118fc7
--- /dev/null
+++ b/tests/e2e/tests/modules/pubmembers/lib.ok
@@ -0,0 +1,15 @@
+// a module's exported class: pub members are the importer's surface, the
+// private ring holds across the module boundary (patch 51).
+pub class Account {
+  pub let mut balance = 0;
+  pub let owner = "anon";
+  let fee = 1;
+
+  pub fu deposit(amount) {
+    this.balance = this.balance + amount - this.fee;
+    return this.balance;
+  }
+  pub fu charged() { return this.fee; }
+  pub static let mut opened = 0;
+  pub static fu house() { Account.opened = Account.opened + 1; return Account.opened; }
+}
diff --git a/tests/e2e/tests/modules/pubmembers/main.ok b/tests/e2e/tests/modules/pubmembers/main.ok
new file mode 100644
index 0000000..7433a25
--- /dev/null
+++ b/tests/e2e/tests/modules/pubmembers/main.ok
@@ -0,0 +1,24 @@
+// cross-module pub fields (patch 51): the imported class's pub members are
+// the surface, slot loads both sides of the module line.
+import "./lib.ok";
+
+let a = lib.Account();
+print a.owner; // expect: anon
+a.balance = 10;
+print a.balance; // expect: 10
+print a.deposit(5); // expect: 14
+print a.balance; // expect: 14
+print a.charged(); // expect: 1
+
+print lib.Account.opened; // expect: 0
+print lib.Account.house(); // expect: 1
+print lib.Account.opened; // expect: 1
+lib.Account.opened = 9;
+print lib.Account.opened; // expect: 9
+
+// a script subclass of the imported class inherits the pub layout
+class Joint : lib.Account {}
+let j = Joint();
+j.balance = 100;
+print j.balance; // expect: 100
+print j.deposit(1); // expect: 100
diff --git a/tests/e2e/tests/modules/pubmembers_private/lib.ok b/tests/e2e/tests/modules/pubmembers_private/lib.ok
