diff --git a/tests/e2e/tests/classes/pub_fields.ok b/tests/e2e/tests/classes/pub_fields.ok
new file mode 100644
index 0000000..007d71a
--- /dev/null
+++ b/tests/e2e/tests/classes/pub_fields.ok
@@ -0,0 +1,34 @@
+// patch 51: fields join the visibility ring. `pub let` opens the member
+// outside the defining hierarchy, the getter-free surface. the private
+// default stays pinned by privacy_fields.ok.
+class Point {
+  pub let mut x;
+  pub let mut y;
+  let label = "p";
+
+  fu init(x, y) {
+    this.x = x;
+    this.y = y;
+  }
+
+  pub fu sum() { return x + y; }
+}
+let p = Point(2, 3);
+print p.x; // expect: 2
+print p.y; // expect: 3
+p.x = 20;
+print p.x + p.y; // expect: 23
+print p.sum(); // expect: 23
+
+// the initializer thunk runs per instance, pub or not
+let q = Point(7, 1);
+print q.x; // expect: 7
+
+// inherited pub fields ride the flat layout down the chain
+class Big : Point {
+  pub fu area() { return this.x * this.y; }
+}
+let b = Big(5, 6);
+print b.x; // expect: 5
+b.y = 60;
+print b.area(); // expect: 300
