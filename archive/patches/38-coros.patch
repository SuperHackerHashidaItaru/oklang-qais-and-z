+  }
+  if (p_coro->state == NULL) {
+    p_coro->state = coro_state_create(p_vm, p_coro);
+    if (p_coro->state == NULL) {
+      runtime_oom(p_vm, "out of memory: failed to allocate a coroutine state.");
+      return false;
+    }
+  }
+  execution_state* cs = p_coro->state;
