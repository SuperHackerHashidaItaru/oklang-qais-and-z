diff --git a/tests/e2e/tests/coros/basic.ok b/tests/e2e/tests/coros/basic.ok
new file mode 100644
index 0000000..68407da
--- /dev/null
+++ b/tests/e2e/tests/coros/basic.ok
@@ -0,0 +1,46 @@
+// R20-R24: the coro surface. coro(fu) constructs (the body does NOT run),
+// resume drives, yield is the two-way channel (the value goes out, the next
+// resume's argument is the yield expression's own result), the body's final
+// return is the last resume's value, a dead coro answers null (R21), and
+// status() spells the lifecycle.
+let c = coro(fu(n) {
+  print("start " + n as str);
+  let mut i = 0;
+  while i < n {
+    let got = yield i;
+    print("got " + got as str);
+    i = i + 1;
+  }
+  return "done";
+});
+print(c.status());          // expect: ready
+print(c);                   // expect: <coro ready>
+print(c.resume(2));         // expect: start 2
+// expect: 0
+print(c.resume("hello"));   // expect: got hello
+// expect: 1
+print(c.status());          // expect: suspended
+print(c.resume());          // expect: got null
+// expect: done
+print(c.resume());          // expect: null
+print(c.status());          // expect: dead
+print(c);                   // expect: <coro dead>
+print(c.resume());          // expect: null
+print(c.resume("x"));       // expect: null
+
+// the bare form: yield; is yield null; - and `return yield;` parks on the
+// way out (null), the NEXT resume's argument is the return value
+let b = coro(fu() {
+  yield;
+  return yield;
+});
+print(b.resume());   // expect: null
+print(b.resume());   // expect: null
+print(b.resume(42)); // expect: 42
+
+// the class value itself
+print(coro);                // expect: <class coro>
+print(classof(c) === coro); // expect: true
+print(c is coro);           // expect: true
+print(isinstance(c, coro)); // expect: true
+print(coro is Class);       // expect: true
diff --git a/tests/e2e/tests/coros/classes_interplay.ok b/tests/e2e/tests/coros/classes_interplay.ok
new file mode 100644
index 0000000..e864a17
--- /dev/null
+++ b/tests/e2e/tests/coros/classes_interplay.ok
@@ -0,0 +1,42 @@
+// classes and coros compose both ways: instances constructed and held inside
+// a coro survive parks (their registers are the coro's state), and methods
+// called inside the body run in the coro's call tree (a yield under one
+// suspends the coro - the method frame parks with the rest).
+class Counter {
+  let mut n = 0;
+  fu init(n) { this.n = n; }
+  pub fu bump() {
+    this.n = this.n + 1;
+    return this.n;
+  }
+  pub fu value() { return this.n; }
+}
+let c = coro(fu() {
+  let k = Counter(10);
+  yield k.bump();
+  yield k.bump();
+  return k.value();
+});
+print(c.resume()); // expect: 11
+print(c.resume()); // expect: 12
+print(c.resume()); // expect: 12
+
+// a bound method value as the drive of an ordinary call inside the body
+let d = coro(fu() {
+  let k = Counter(0);
+  let b = k.bump;
+  yield b();
+  return b();
+});
+print(d.resume()); // expect: 1
+print(d.resume()); // expect: 2
+
+// construction inside the coro (no yield in the constructor - that lane is
+// barred, its own error test)
+let e = coro(fu() {
+  let k = Counter(5);
+  yield k.value();
+  return "made";
+});
+print(e.resume()); // expect: 5
+print(e.resume()); // expect: made
diff --git a/tests/e2e/tests/coros/coro_in_coro.ok b/tests/e2e/tests/coros/coro_in_coro.ok
new file mode 100644
index 0000000..e5e67f4
--- /dev/null
+++ b/tests/e2e/tests/coros/coro_in_coro.ok
@@ -0,0 +1,19 @@
+// a coro resumed from inside another coro: the resume native runs under the
+// outer coro's state, swaps to the inner's, and swaps back - the outer's
+// parked frames root through the resumer chain while the inner runs.
+let inner = coro(fu() {
+  yield "i1";
+  return "idone";
+});
+let outer = coro(fu() {
+  print("outer got: " + inner.resume());
+  yield "o1";
+  print("outer got: " + inner.resume());
+  return "odone";
+});
+print(outer.resume());  // expect: outer got: i1
+// expect: o1
+print(outer.resume());  // expect: outer got: idone
+// expect: odone
+print(inner.status());  // expect: dead
+print(outer.status());  // expect: dead
diff --git a/tests/e2e/tests/coros/defers.ok b/tests/e2e/tests/coros/defers.ok
new file mode 100644
index 0000000..9f3763a
--- /dev/null
+++ b/tests/e2e/tests/coros/defers.ok
@@ -0,0 +1,37 @@
+// defers at suspend are PARKED, not run (the frames stay exactly as they
+// were); they run at the coro's death, lifo - normal completion runs them in
+// bytecode at the scope exits, error death runs them in the death sweep.
+fu close(tag) {
+  print("closing " + tag);
+  return true;
+}
+let c = coro(fu() {
+  defer close("a");
+  defer close("b");
+  yield 1;
+  print("mid");
+  return "end";
+});
+print(c.resume()); // expect: 1
+print(c.resume()); // expect: mid
+// expect: closing b
+// expect: closing a
+// expect: end
+
+// a defer that yields on the NORMAL exit lane is bytecode-driven (the
+// OP_DEFER_RUN arm stages the thunk in the same dispatch loop): the coro
+// parks mid-cleanup and the chain finishes on the next resume.
+fu ydef() {
+  yield "from-defer";
+  print("defer tail");
+  return true;
+}
+let d = coro(fu() {
+  defer ydef();
+  print("body before return");
+  return 2;
+});
+print(d.resume()); // expect: body before return
+// expect: from-defer
+print(d.resume()); // expect: defer tail
+// expect: 2
diff --git a/tests/e2e/tests/coros/error_crossing.ok b/tests/e2e/tests/coros/error_crossing.ok
new file mode 100644
index 0000000..8ee6e2b
--- /dev/null
+++ b/tests/e2e/tests/coros/error_crossing.ok
@@ -0,0 +1,49 @@
+// R22 + the transplant: an error inside a coro runs the body's defers (the
+// death sweep, on the coro's own state), then crosses to the resumer's lane -
+// the resume call site is where a catch sees it, and the coro is dead after.
+fu say(what) {
+  print(what);
+  return true;
+}
+
+let c = coro(fu() {
+  defer say("cleanup ran");
+  yield 1;
+  throw "boom";
+});
+print(c.resume()); // expect: 1
+try {
+  print(c.resume()); // the defer runs inside this call, before the catch
+} catch e {
+  // expect: cleanup ran
+  print("caught: " + e as str); // expect: caught: boom
+}
+print(c.status()); // expect: dead
+print(c.resume()); // expect: null
+
+// a runtime-raised error crosses the same way (kind + text, not a thrown value)
+let r = coro(fu() {
+  yield 1;
+  return [1][5];
+});
+print(r.resume()); // expect: 1
+try {
+  print(r.resume());
+} catch e {
+  print("kind: " + e["kind"] as str); // expect: kind: index
+}
+print(r.status()); // expect: dead
+
+// an error the body catches itself never leaves: the coro survives
+let s = coro(fu() {
+  try {
+    throw "inner";
+  } catch e {
+    print("inside caught: " + e as str);
+  }
+  yield 1;
+  return "ok";
+});
+print(s.resume()); // expect: inside caught: inner
+// expect: 1
+print(s.resume()); // expect: ok
diff --git a/tests/e2e/tests/coros/errors/body_arity_error.ok b/tests/e2e/tests/coros/errors/body_arity_error.ok
new file mode 100644
index 0000000..2440180
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/body_arity_error.ok
@@ -0,0 +1,8 @@
+// the body's own arity is a plain call contract: the first resume's argument
+// is the body's argument, so a one-parameter body resumed bare is the
+// ordinary too-few-arguments error (defaults and varargs work the same as
+// any call).
+let c = coro(fu(a) {
+  return a;
+});
+print(c.resume()); // expect error: invalid call to 'fu': expected 1 argument, got 0.
diff --git a/tests/e2e/tests/coros/errors/body_not_fu_error.ok b/tests/e2e/tests/coros/errors/body_not_fu_error.ok
new file mode 100644
index 0000000..c225828
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/body_not_fu_error.ok
@@ -0,0 +1,3 @@
+// the coro body must be a plain fu (a closure value); numbers, classes,
+// natives and bound methods are refused with the honest message.
+print(coro(5)); // expect error: the coro body must be a fu.
diff --git a/tests/e2e/tests/coros/errors/resume_arity_error.ok b/tests/e2e/tests/coros/errors/resume_arity_error.ok
new file mode 100644
index 0000000..1d4b349
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/resume_arity_error.ok
@@ -0,0 +1,6 @@
+// resume takes at most one value in (the yield expression's result).
+let c = coro(fu() {
+  yield 1;
+  return 2;
+});
+print(c.resume(1, 2)); // expect error: invalid call to method 'resume' of class 'coro': expected at most 1 argument, got 2.
diff --git a/tests/e2e/tests/coros/errors/resume_running_error.ok b/tests/e2e/tests/coros/errors/resume_running_error.ok
new file mode 100644
index 0000000..abcc6ae
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/resume_running_error.ok
@@ -0,0 +1,9 @@
+// re-entrancy: resuming a running coro (here: itself, through a glob the
+// body can reach) is the one drive error.
+glob let mut self_coro = null;
+let c = coro(fu() {
+  self_coro.resume();
+  return 0;
+});
+self_coro = c;
+print(c.resume()); // expect error: resume of a running coroutine.
diff --git a/tests/e2e/tests/coros/errors/yield_in_constructor_error.ok b/tests/e2e/tests/coros/errors/yield_in_constructor_error.ok
new file mode 100644
index 0000000..67960ed
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/yield_in_constructor_error.ok
@@ -0,0 +1,12 @@
+// a yield from inside a constructor can never resume honestly: the
+// construction lane's C frame (construct_instance) holds the instance
+// publishing and the watermark restore after the nested run_until returns.
+class K {
+  fu init() {
+    yield 1;
+  }
+}
+let c = coro(fu() {
+  return K();
+});
+print(c.resume()); // expect error: cannot yield from inside a constructor.
diff --git a/tests/e2e/tests/coros/errors/yield_in_defer_error.ok b/tests/e2e/tests/coros/errors/yield_in_defer_error.ok
new file mode 100644
index 0000000..0a36b39
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/yield_in_defer_error.ok
@@ -0,0 +1,13 @@
+// a yield from a defer running on the UNWIND lane (an error is in flight):
+// the scan's C frame holds the rest of the cascade. the normal scope-exit
+// lane is bytecode-driven and parks fine (see defers.ok) - this is the
+// error-path half.
+fu bad() {
+  yield 1;
+  return true;
+}
+let c = coro(fu() {
+  defer bad();
+  throw "x";
+});
+print(c.resume()); // expect error: cannot yield from inside a defer.
diff --git a/tests/e2e/tests/coros/errors/yield_in_operator_error.ok b/tests/e2e/tests/coros/errors/yield_in_operator_error.ok
new file mode 100644
index 0000000..b4d7d24
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/yield_in_operator_error.ok
@@ -0,0 +1,14 @@
+// a yield from inside an operator method dispatch: the operator lane's C
+// frame (dispatch_operator_method) copies the result into the caller's
+// register after the nested run_until returns - a parked operator has no
+// honest resume.
+class K {
+  pub fu operator +(o) {
+    yield 1;
+    return 2;
+  }
+}
+let c = coro(fu() {
+  return K() + 1;
+});
+print(c.resume()); // expect error: cannot yield from inside an operator method.
diff --git a/tests/e2e/tests/coros/errors/yield_outside_error.ok b/tests/e2e/tests/coros/errors/yield_outside_error.ok
new file mode 100644
index 0000000..6c27201
--- /dev/null
+++ b/tests/e2e/tests/coros/errors/yield_outside_error.ok
@@ -0,0 +1,8 @@
+// yield is coro-only: a plain function called from main that yields is the
+// compile-time-impossible, runtime-honest refusal (any function can BECOME a
+// coro body, so the check lives in the opcode handler).
+fu plain() {
+  yield 1;
+  return 2;
+}
+print(plain()); // expect error: yield outside a coroutine.
diff --git a/tests/e2e/tests/coros/gc_parked.ok b/tests/e2e/tests/coros/gc_parked.ok
new file mode 100644
index 0000000..dc3774f
--- /dev/null
+++ b/tests/e2e/tests/coros/gc_parked.ok
@@ -0,0 +1,27 @@
+// the collector must walk a parked coro's state like a live vm's (registers,
+// call stack closures, open upvalues) and the parked resumer's too. the
+// churn between resumes forces collections (every allocation, under the
+// aggressive gate) while both sides hold live values.
+let c = coro(fu() {
+  let keep = ["a", "b", "c"];
+  let mut n = 0;
+  while n < 3 {
+    yield keep[n];
+    n = n + 1;
+  }
+  return len(keep);
+});
+print(c.resume()); // expect: a
+let mut junk = 0;
+let mut i = 0;
+while i < 300 {
+  let trash = [i, i + 1, i + 2];
+  let m = {"k": i, "v": trash};
+  junk = junk + len(m["v"]) - 2;
+  i = i + 1;
+}
+print(junk);       // expect: 300
+print(c.resume()); // expect: b
+print(c.resume()); // expect: c
+print(c.resume()); // expect: 3
+print(c.status()); // expect: dead
diff --git a/tests/e2e/tests/coros/nested_calls.ok b/tests/e2e/tests/coros/nested_calls.ok
new file mode 100644
index 0000000..c3e0787
--- /dev/null
+++ b/tests/e2e/tests/coros/nested_calls.ok
@@ -0,0 +1,20 @@
+// the coro's call tree is the coro's: a yield from a function the body called
+// suspends the WHOLE coro (what makes it a coroutine, not a generator loop).
+// inner(10) runs inside the coro's frames - its two yields park the coro,
+// its return value is just the call's result in the body.
+fu inner(a) {
+  yield a;
+  yield a + 1;
+  return a + 2;
+}
+let c = coro(fu() {
+  let r1 = inner(10);
+  let r2 = yield "mid";
+  print("r2: " + r2 as str);
+  return r1 + r2;
+});
+print(c.resume());  // expect: 10
+print(c.resume());  // expect: 11
+print(c.resume());  // expect: mid
+print(c.resume(5)); // expect: r2: 5
+// expect: 17
diff --git a/tests/e2e/tests/coros/status_running.ok b/tests/e2e/tests/coros/status_running.ok
new file mode 100644
index 0000000..3cc83b6
--- /dev/null
+++ b/tests/e2e/tests/coros/status_running.ok
@@ -0,0 +1,15 @@
+// the running window: status() inside the body (through a glob the body can
+// reach) reports "running" - re-entrancy is what the status guards against.
+glob let mut me = null;
+let c = coro(fu() {
+  print(me.status());
+  yield 1;
+  return 0;
+});
+me = c;
+print(c.status());  // expect: ready
+print(c.resume());  // expect: running
+// expect: 1
+print(c.status());  // expect: suspended
+print(c.resume());  // expect: 0
+print(c.status());  // expect: dead
diff --git a/tests/e2e/tests/coros/upvalues.ok b/tests/e2e/tests/coros/upvalues.ok
new file mode 100644
index 0000000..c863029
--- /dev/null
+++ b/tests/e2e/tests/coros/upvalues.ok
@@ -0,0 +1,33 @@
+// upvalues across the coro boundary. cells captured in the resumer resolve
+// through the vm's own register file even while the coro's state is current
+// (the shared-cell semantics: both sides see each other's writes), and cells
+// captured INSIDE the coro resolve through the coro's state - a closure that
+// escapes a parked coro pins the coro (and its register file) alive through
+// the upvalue's trace until the cell closes.
+let mut shared = 10;
+let c = coro(fu() {
+  print(shared);          // read the resumer's cell
+  shared = shared + 1;    // write it back
+  yield 1;
+  print(shared);          // see the resumer's mid-park write
+  return 0;
+});
+print(c.resume()); // expect: 10
+// expect: 1
+shared = 99;
+print(c.resume()); // expect: 99
+// expect: 0
+print(shared);     // expect: 99
+
+// the escaped closure: captures a cell of the coro's own frame
+let mut esc = null;
+let p = coro(fu() {
+  let x = 7;
+  esc = fu() { return x + 1; };
+  yield 1;
+  return 0;
+});
+print(p.resume()); // expect: 1
+print(esc());      // expect: 8
+print(p.resume()); // expect: 0
+print(esc());      // expect: 8
