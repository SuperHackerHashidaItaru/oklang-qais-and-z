@@ -0,0 +1,25 @@
+// the builtin class singletons as global values (C10): one per lane under
+// Object, one metaclass for all of them. they are ordinary values - store
+// them, pass them, compare them by identity.
+print(num is Class); // expect: true
+print(str is Class); // expect: true
+print(bool is Class); // expect: true
+print(array is Class); // expect: true
+print(map is Class); // expect: true
+print(function is Class); // expect: true
+print(nil is Class); // expect: true
+print(Object is Class); // expect: true
+print(classof(str) === Class); // expect: true
+// under the root
+print(isinstance(str, Object)); // expect: true
+print(isinstance(nil, Object)); // expect: true
+print(isinstance(Object, Object)); // expect: true
+// identity comparison, the right semantics for class values
+print(str == str); // expect: true
+print(str == num); // expect: false
+let saved = num;
+print(saved === num); // expect: true
+// passable like any value
+fu same(a, b) { return a === b; }
+print(same(str, str)); // expect: true
+print(same(str, num)); // expect: false
