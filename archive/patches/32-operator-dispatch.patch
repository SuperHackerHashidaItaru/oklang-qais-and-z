diff --git a/tests/e2e/tests/classes/bare_method_call.ok b/tests/e2e/tests/classes/bare_method_call.ok
new file mode 100644
index 0000000..7481d2f
--- /dev/null
+++ b/tests/e2e/tests/classes/bare_method_call.ok
@@ -0,0 +1,32 @@
+// R1: methods participate in bare-name resolution, implicitly bound to this.
+// the resolution order, pinned: READS are field-first (data wins), CALL SITES
+// fuse to INVOKE and are method-first (invoking wins). a bare name in call
+// position is a READ that gets called - a field shadowing a method name makes
+// the bare call hit the field's value.
+class Animal {
+  let name = "";
+  fu init(name) { this.name = name; }
+  pub fu describe() { return name + " speaks"; }
+  pub fu speak() { return describe() + " loudly"; } // bare sibling call
+  fu secret() { return "hidden"; }
+  pub fu reveal() { return secret(); } // bare private call
+  pub fu both() { return describe() + " | " + this.describe(); } // both lanes
+}
+let a = Animal("rex");
+print(a.speak()); // expect: rex speaks loudly
+print(a.reveal()); // expect: hidden
+print(a.both()); // expect: rex speaks | rex speaks
+// the shadow shape: one name, a field and a method
+class Shadow {
+  let x = "field";
+  pub fu x() { return "method"; }
+  pub fu read_bare() { return x; } // bare read: the field
+  pub fu read_this() { return this.x; } // this-relative read: the field
+  pub fu call_this() { return this.x(); } // invoke site: the method
+}
+let s = Shadow();
+print(s.read_bare()); // expect: field
+print(s.read_this()); // expect: field
+print(s.call_this()); // expect: method
+print(s.read_bare()); // expect: field
+print(s.call_this()); // expect: method
diff --git a/tests/e2e/tests/classes/bare_static_method.ok b/tests/e2e/tests/classes/bare_static_method.ok
new file mode 100644
index 0000000..04e7106
--- /dev/null
+++ b/tests/e2e/tests/classes/bare_static_method.ok
@@ -0,0 +1,20 @@
+// the statics lane's runtime ladder: a bare name in a static context resolves
+// static fields first, then static methods (a sibling call binds this=class),
+// then globals. the instance lane bakes the same ladder at freeze.
+glob let g = 5;
+glob let mut gm = 1;
+class Registry {
+  static let mut count = 0;
+  static let label = "reg";
+  pub static fu bump() { count = count + 1; return count; }
+  pub static fu bump_twice() { bump(); return bump(); } // bare sibling static call
+  pub static fu label_of() { return label; } // bare static field
+  pub static fu read_g() { return g; } // bare global fallback
+  pub static fu grow() { gm = gm + 1; return gm; } // bare global store
+}
+print(Registry.bump_twice()); // expect: 2
+print(Registry.bump_twice()); // expect: 4
+print(Registry.label_of()); // expect: reg
+print(Registry.read_g()); // expect: 5
+print(Registry.grow()); // expect: 2
+print(gm); // expect: 2
