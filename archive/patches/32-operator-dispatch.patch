+    // same contract as call()'s growth: fresh slots must read as null
+    const uint32_t target = saved_top + need + ((saved_top + need) >> 1u);
+    const uint32_t new_capacity = target > UINT16_MAX + 1u ? UINT16_MAX + 1u : target;
