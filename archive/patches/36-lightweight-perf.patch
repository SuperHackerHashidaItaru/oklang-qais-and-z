index 0000000..9c8d36a
--- /dev/null
+++ b/tests/e2e/tests/loops/fused_conditions.ok
@@ -0,0 +1,69 @@
+// the fused condition lane: a direct comparison in an if/while/for condition
+// compiles to one instruction (OP_JUMP_IF_CMP) instead of the binop's bool +
+// OP_JUMP_IF pair. this file pins the semantics of every fusable comparator
+// through all three statement forms, with both operands in every home (local
+// register, constant, expression temp) - the fusion must be invisible.
+let a = 3;
+let b = 7;
+let n = 4;
+
+// if with every comparator, constant and register rhs
