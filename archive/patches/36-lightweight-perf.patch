diff --git a/tests/e2e/tests/classes/fused_operator_conditions.ok b/tests/e2e/tests/classes/fused_operator_conditions.ok
new file mode 100644
index 0000000..6dcd3fc
--- /dev/null
+++ b/tests/e2e/tests/classes/fused_operator_conditions.ok
@@ -0,0 +1,40 @@
+// the fused comparison's operator dispatch: `if (a == b)` where the left
+// operand's class defines operator == must dispatch exactly like the value
+// binop would. same for the ordered comparisons inside conditions.
+class Version {
+  let major = 0;
+  let minor = 0;
+  fu init(major, minor) { this.major = major; this.minor = minor; }
+  pub fu operator ==(o) { return major == o.major and minor == o.minor; }
+  pub fu operator <(o) { return major < o.major or (major == o.major and minor < o.minor); }
+  pub fu key() { return major + minor; }
+}
+let v1 = Version(1, 0);
+let v2 = Version(1, 0);
+let v3 = Version(2, 1);
+
+// == dispatches through the fused if
+if v1 == v2 { print "eq-dispatch"; } // expect: eq-dispatch
+if v1 == v3 { print "eq-bad"; }
+
+// the negated form of a dispatched ==
+if v1 == v3 { print "neq-bad"; } else { print "neq-else"; } // expect: neq-else
+
+// < dispatches through the fused while bound
+let mut count = 0;
+let mut cur = Version(0, 3);
+while cur < v3 {
+  count = count + 1;
+  cur = Version(count, 3);
+}
+print count; // expect: 2
+
+// the same operators through the value lane (non-fused) agree
+print(v1 == v2); // expect: true
+print(v1 < v3); // expect: true
+print(v3 < v1); // expect: false
+
+// dispatch errors surface from the fused lane with the right message
+class NoCompare { pub fu tag() { return 1; } }
+let x = NoCompare();
+if x < 5 { print "unreachable"; } // expect error: invalid operands for binary '<'
diff --git a/tests/e2e/tests/classes/interned_names.ok b/tests/e2e/tests/classes/interned_names.ok
new file mode 100644
index 0000000..e320e65
--- /dev/null
+++ b/tests/e2e/tests/classes/interned_names.ok
@@ -0,0 +1,53 @@
+// the string interner: compiler-made names canonicalize so member probes hit
+// the pointer fast path. this pins the OBSERVABLE contracts that must not
+// change when interning is on: identical spellings resolve to one method,
+// distinct-but-equal runtime strings still compare by content, and ===
+// stays word identity (literals are NOT interned - two occurrences of the
+// same literal are distinct words).
+class Names {
+  pub fu len() { return 42; } // a method spelled like a builtin
+  pub fu get() { return 1; }
+}
+let ns = Names();
+print(ns.len()); // expect: 42
+print len(ns); // expect error: invalid argument: 'len' expects an array or a map.
+
+// the same method name on many classes: every lookup finds its own
+class One { pub fu who() { return 1; } }
+class Two { pub fu who() { return 2; } }
+class Three : One { pub fu who2() { return who() + 30; } }
+print One().who(); // expect: 1
+print Two().who(); // expect: 2
+print Three().who2(); // expect: 31
+
+// canonical operator spellings: definition and dispatch sites agree across
+// whitespace spellings (the parser normalizes, the interner canonicalizes)
+class Spaced {
+  let v = 0;
+  fu init(v) { this.v = v; }
+  pub fu operator +(o) { return Spaced(v + o.v); }
+  pub fu operator  <  (o) { return v < o.v; }
+  pub fu get() { return v; }
+}
+print (Spaced(1) + Spaced(2)).get(); // expect: 3
+print Spaced(1) < Spaced(2); // expect: true
+
+// runtime-built strings compare by CONTENT against literals and each other
+let lit = "abc";
+let built = "ab" + "c";
+print(lit == built); // expect: true
+print(built == "abc"); // expect: true
+print(built != "xyz"); // expect: true
+
+// map keys: a literal key and a runtime-built equal key address one entry
+let m = { "k": 1 };
+m["b" + "uilt"] = 2;
+print(m["k"]); // expect: 1
+print(m["built"]); // expect: 2
+print(m["b" + "uilt"]); // expect: 2
+
+// === stays word identity: two literal occurrences are distinct words even
+// when the content matches (interning covers NAMES, never literal values)
+print("same" === "same"); // expect: false
+let s = "same";
+print(s === s); // expect: true
diff --git a/tests/e2e/tests/classes/poly_mic.ok b/tests/e2e/tests/classes/poly_mic.ok
new file mode 100644
index 0000000..5d2245d
--- /dev/null
+++ b/tests/e2e/tests/classes/poly_mic.ok
@@ -0,0 +1,70 @@
+// the polymorphic inline cache: one call site, several receiver classes
+// alternating. the 3-way probe chain must keep every lane hitting (the old
+// single-entry mic thrashed on exactly this shape). five classes so the
+// chain also exercises round-robin eviction - and correctness never depends
+// on which entry won the slot.
+class A { pub fu tag() { return 1; } }
+class B { pub fu tag() { return 2; } }
+class C { pub fu tag() { return 3; } }
+class D { pub fu tag() { return 4; } }
+class E { pub fu tag() { return 5; } }
+
+let objs = [A(), B(), C(), D(), E()];
+let mut sum = 0;
+let mut round = 0;
+while round < 3 {
+  let mut idx = 0;
+  while idx < 5 {
+    sum = sum + objs[idx].tag();
+    idx = idx + 1;
+  }
+  round = round + 1;
+}
+print sum; // expect: 45
+
+// mixed lanes at one site: instance receivers, class receivers (statics),
+// and a builtin receiver (the native lane) - the cache keys them apart.
+class Meta {
+  pub static fu who() { return 10; }
+  pub fu mine() { return 20; }
+}
+let m = Meta();
+let mut acc = 0;
+let mut q = 0;
+while q < 2 {
+  acc = acc + m.mine();
+  acc = acc + Meta.who();
+  acc = acc + [1, 2, 3, 4].len();
+  q = q + 1;
+}
+print acc; // expect: 68
+
+// fields at a polymorphic site: three classes with the same field name at
+// different slots (inheritance shifts the layout) - the cache carries the
+// per-class slot.
+class Base { let x = 0; fu init(x) { this.x = x; } pub fu getx() { return x; } }
+class Mid : Base {}
+class Leaf : Mid { let y = 0; fu init(x, y) { super(x); this.y = y; } pub fu sum() { return getx() + y; } }
+let shapes = [Base(1), Mid(2), Leaf(3, 4)];
+let mut fields = 0;
+let mut w = 0;
+while w < 3 {
+  fields = fields + shapes[w].getx(); // the method, not the private field
+  w = w + 1;
+}
+print fields; // expect: 6
+print Leaf(3, 4).sum(); // expect: 7
+
+// a field-then-method flip at one site (the shadow shape): reads are
+// field-first, call sites are method-first. the probe runs from inside the
+// ring (fields are hierarchy-internal, the C++ ring).
+class Shadow {
+  let mut f = 0;
+  pub fu f() { return 99; }
+  fu init() { f = 5; }
+  pub fu probe() { return f; }        // the field (read lane)
+  pub fu probe_call() { return this.f(); } // the method (explicit call lane)
+}
+let sh = Shadow();
+print sh.probe(); // expect: 5
+print sh.probe_call(); // expect: 99
diff --git a/tests/e2e/tests/loops/fused_conditions.ok b/tests/e2e/tests/loops/fused_conditions.ok
