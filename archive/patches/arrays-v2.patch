diff --git a/src/ok.c b/src/ok.c
index 233a593..f207b24 100644
--- a/src/ok.c
+++ b/src/ok.c
@@ -25,6 +25,118 @@ struct ok {
   ok_allocators raw_alloc;
 };
 
+// core array natives. these are stopgaps in the natives-as-globals shape (D16):
+// when classes + methods land, push/pop/remove become methods and these globals
+// either retire or stay as free functions (len likely stays, go-style).
+// errors go through ok_native_error -> vm_native_error, the supported path.
+
+static ok_value native_len(ok* p_ok, uint8_t p_argc, const ok_value* p_argv) {
+  (void)p_argc;
+  if (!IS_VALUE_ARRAY(p_argv[0])) {
+    ok_native_error(p_ok, ok_create_string_view("invalid argument: 'len' expects an array.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+    return NULL_AS_VALUE();
+  }
+  // f64 out, never an int tag: D3, numbers are the only public numeric type
+  return NUMBER_AS_VALUE((double)VALUE_AS_ARRAY(p_argv[0])->values.count);
+}
+
+static ok_value native_push(ok* p_ok, uint8_t p_argc, const ok_value* p_argv) {
+  (void)p_argc;
+  if (!IS_VALUE_ARRAY(p_argv[0])) {
+    ok_native_error(p_ok, ok_create_string_view("invalid argument: 'push' expects an array.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+    return NULL_AS_VALUE();
+  }
+  object_array* arr = VALUE_AS_ARRAY(p_argv[0]);
+  // no gc guard needed here: the array is rooted through the caller's argument
+  // window ([0, top) marking), and value_array_append only reallocs the array's
+  // own buffer -- it never triggers a collection. do not "fix" this.
+  if (!value_array_append(&arr->values, p_argv[1])) {
+    ok_native_error(p_ok, ok_create_string_view("out of memory: failed to grow array.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+    return NULL_AS_VALUE();
+  }
+  return NULL_AS_VALUE(); // inert: no chaining cleverness, no accidental length-of
+}
+
+static ok_value native_pop(ok* p_ok, uint8_t p_argc, const ok_value* p_argv) {
+  (void)p_argc;
+  if (!IS_VALUE_ARRAY(p_argv[0])) {
+    ok_native_error(p_ok, ok_create_string_view("invalid argument: 'pop' expects an array.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+    return NULL_AS_VALUE();
+  }
+  object_array* arr = VALUE_AS_ARRAY(p_argv[0]);
+  if (arr->values.count == 0) {
+    return NULL_AS_VALUE(); // pop on empty is null, locked in D4
+  }
+  const value popped = arr->values.data[arr->values.count - 1];
+  value_array_pop(&arr->values); // does not shrink capacity, ever; fine, documented
+  return popped;
+}
+
+// remove(a, m, n): in-place removal of the half-open range [m, n). the language
+// surface is half-open (0-based indices compose with loop bounds, empty range is
+// m == n, adjacent ranges share an endpoint); the underlying OK_ARRAY remove is
+// inclusive-end, so translate here and keep the conventions where they belong.
+static ok_value native_remove(ok* p_ok, uint8_t p_argc, const ok_value* p_argv) {
+  (void)p_argc;
+  if (!IS_VALUE_ARRAY(p_argv[0])) {
+    ok_native_error(p_ok, ok_create_string_view("invalid argument: 'remove' expects an array.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+    return NULL_AS_VALUE();
+  }
+  uint32_t range[2] = {0, 0};
+  for (uint8_t i = 1; i < 3; ++i) {
+    const value v = p_argv[i];
+    if (IS_VALUE_NUMBER(v)) {
+      const double d = VALUE_AS_NUMBER(v);
+      // cast-based integrality (no libm); the range guard runs first
+      if (!(d >= -9.0e15 && d <= 9.0e15) || d != (double)(int64_t)d) {
+        ok_native_error(p_ok, ok_create_string_view("invalid range for 'remove': bounds must be whole numbers.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+        return NULL_AS_VALUE();
+      }
+      if (d < 0 || d > (double)UINT32_MAX) {
+        ok_native_error(p_ok, ok_create_string_view("invalid range for 'remove'.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+        return NULL_AS_VALUE();
+      }
+      range[i - 1] = (uint32_t)d;
+    } else if (!IS_VALUE_NUMBER(v) && IS_VALUE_INT(v)) {
+      const int64_t iv = VALUE_AS_INT(v);
+      if (iv < 0 || iv > (int64_t)UINT32_MAX) {
+        ok_native_error(p_ok, ok_create_string_view("invalid range for 'remove'.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+        return NULL_AS_VALUE();
+      }
+      range[i - 1] = (uint32_t)iv;
+    } else {
+      ok_native_error(p_ok, ok_create_string_view("invalid range for 'remove': bounds must be numbers.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+      return NULL_AS_VALUE();
+    }
+  }
+  object_array* arr = VALUE_AS_ARRAY(p_argv[0]);
+  if (range[0] > range[1] || range[1] > arr->values.count) {
+    ok_native_error(p_ok, ok_create_string_view("invalid range for 'remove'.", OK_STRING_VIEW_CALCULATE_LENGTH, true));
+    return NULL_AS_VALUE();
+  }
+  if (range[0] < range[1]) { // empty range is a legal no-op
+    value_array_remove(&arr->values, range[0], range[1] - 1); // inclusive-end impl
+  }
+  return NULL_AS_VALUE();
+}
+
+static bool ok_define_core_natives(ok* p_ok) {
+  const ok_string_view names[] = {
+      ok_create_string_view("len", OK_STRING_VIEW_CALCULATE_LENGTH, true),
+      ok_create_string_view("push", OK_STRING_VIEW_CALCULATE_LENGTH, true),
+      ok_create_string_view("pop", OK_STRING_VIEW_CALCULATE_LENGTH, true),
+      ok_create_string_view("remove", OK_STRING_VIEW_CALCULATE_LENGTH, true),
+  };
+  const uint8_t arities[] = {1, 2, 1, 3};
+  const ok_native_fn functions[] = {native_len, native_push, native_pop, native_remove};
+  for (uint8_t i = 0; i < 4; ++i) {
+    if (!ok_global_define_native_function(p_ok, names[i], arities[i], functions[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
 ok* ok_create(ok_specs p_specs) {
   patch_specs(&p_specs);
   ok* okay = p_specs.allocators.allocate(sizeof(ok));
@@ -49,6 +161,10 @@ ok* ok_create(ok_specs p_specs) {
       .alloc = &okay->alloc, .globals_store = &okay->globals_store, .objects_store = &okay->objects_store, .ok = okay};
   vm_init(&okay->vm, vm_specs);
   gc_watch_vm(&okay->gc, &okay->vm);
+  if (!ok_define_core_natives(okay)) {
+    ok_free(okay);
+    return NULL;
+  }
   return okay;
 }
 
