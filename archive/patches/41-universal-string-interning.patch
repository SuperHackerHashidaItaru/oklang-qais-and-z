diff --git a/tests/e2e/tests/strings/interning.ok b/tests/e2e/tests/strings/interning.ok
new file mode 100644
index 0000000..d39f163
--- /dev/null
+++ b/tests/e2e/tests/strings/interning.ok
@@ -0,0 +1,37 @@
+// D20: every string is interned - identical content settles on one canonical
+// object, so === (raw word identity) is content truth for strings.
+print('a' === 'a'); // expect: true
+print("a" === 'a'); // expect: true
+print('a' === 'b'); // expect: false
+print('' === ''); // expect: true
+// runtime-built equals literal
+print(('a' + 'b') === 'ab'); // expect: true
+let x = 'he';
+let y = 'llo';
+print((x + y) === 'hello'); // expect: true
+// distinct builds of the same content agree
+print((x + y) === ('hel' + 'lo')); // expect: true
+// conversions land on the canonical object too
+print((12 as str) === '12'); // expect: true
+print((2.5 as str) === '2.5'); // expect: true
+print((true as str) === 'true'); // expect: true
+// == and != unchanged (value equality was already content-based)
+print('ab' == 'ab'); // expect: true
+print('a' != 'b'); // expect: true
+// the negated identity composes through !
+print(!('a' === 'a')); // expect: false
+print(!('a' === 'b')); // expect: true
+// compound-assign builds are canonical too
+let mut s = 'x';
+s += 'y';
+print(s === 'xy'); // expect: true
+// strings fetched from arrays join the same canon
+let arr = ['x', 'y'];
+print((arr[0] + arr[1]) === 'xy'); // expect: true
+// map keys: canonical or not, probing is by content
+let m = {'k': 1};
+print(m['k' + '']); // expect: 1
+// different content never collides; strings never equal other types
+print('ab' === 'ba'); // expect: false
+print('1' === 1); // expect: false
+print('' === null); // expect: false
diff --git a/tests/e2e/tests/strings/interning_churn.ok b/tests/e2e/tests/strings/interning_churn.ok
new file mode 100644
index 0000000..0f56134
--- /dev/null
+++ b/tests/e2e/tests/strings/interning_churn.ok
@@ -0,0 +1,29 @@
+// churn: unique strings created and dropped each iteration. the interner is
+// a weak set (D20): dropped canonicals leave at the next sweep, so the loop
+// must stay correct no matter how many collections ran (the aggressive-gc
+// and asan gates are the real judges of that).
+let mut keep = '';
+for let i = 0 : 500 {
+  let s = 'item-' + i as str;
+  if i == 499 {
+    keep = s;
+  }
+}
+print(keep === 'item-499'); // expect: true
+// rebirth: the same content rebuilt after churn is one object again
+let again = 'item-' + 499 as str;
+print(again === keep); // expect: true
+// repeated growth, then compared against the equal literal
+let mut acc = '';
+for let i = 0 : 8 {
+  acc += 'ab';
+}
+print(acc === 'abababababababab'); // expect: true
+print((acc + '') === acc); // expect: true
+// interning survives a map round trip under churn
+let mut table = {:};
+for let i = 0 : 100 {
+  table['key' + i as str] = i;
+}
+print(table['key' + 42 as str]); // expect: 42
+print(table['key' + 7 as str] == 7); // expect: true
