+                            const token* p_base,
+                            const char* p_pos,
+                            const char** p_line_start,
+                            uint32_t* p_line) {
+  uint32_t line = p_base->line_info.line;
+  for (const char* p = p_base->start; p < p_pos; ++p) {
+    if (*p == '\n') {
+      ++line;
+    }
+  }
+  const char* line_start = p_pos;
+  while (line_start > p_src_base && line_start[-1] != '\n') {
+    --line_start;
