diff --git a/tests/e2e/tests/strings/fmstring.ok b/tests/e2e/tests/strings/fmstring.ok
new file mode 100644
index 0000000..3890c33
--- /dev/null
+++ b/tests/e2e/tests/strings/fmstring.ok
@@ -0,0 +1,23 @@
+// fm"" stacks both rulings: the m"" multiline body (literal newlines, no
+// dedent) with the f"" interpolation (regions may span the newlines, and
+// the tokens after the literal anchor to their real lines). fm is the
+// ruled stacking order; mf"..." is the identifier `mf` beside a plain
+// string (see errors/mf_is_an_identifier.ok).
+let n = 7;
+print fm"first ${n}
+second ${n + 1}
+third"; // expect: first 7
+// expect: second 8
+// expect: third
+let block = fm"
+  header: ${n}
+  footer
+";
+print len(block); // expect: 22
+print fm'quotes ${"both"} ways'; // expect: quotes both ways
+print fm"a region can
+span ${1 +
+2} lines"; // expect: a region can
+// expect: span 3 lines
+print fm"deep ${ f"x${ fm"y${n}" }" } end"; // expect: deep xy7 end
+print "line anchoring after"; // expect: line anchoring after
diff --git a/tests/e2e/tests/strings/fstring.ok b/tests/e2e/tests/strings/fstring.ok
new file mode 100644
index 0000000..e72b80d
--- /dev/null
+++ b/tests/e2e/tests/strings/fstring.ok
@@ -0,0 +1,27 @@
+// the P3 basics: ${} interpolates, everything else is literal. a $ not
+// followed by { is just a dollar, plain chunks stay plain, and the whole
+// literal desugars to string + to_string(expr) chains.
+let name = "ok";
+let n = 42;
+print f"hello ${name}!"; // expect: hello ok!
+print f"n = ${n}, doubled = ${n * 2}"; // expect: n = 42, doubled = 84
+print f"sum: ${1 + 2}"; // expect: sum: 3
+print f"arithmetic rides any expression: ${n > 40}"; // expect: arithmetic rides any expression: true
+print f"no interpolation here"; // expect: no interpolation here
+print f""; // expect:
+print f"$"; // expect: $
+print f"a$ b"; // expect: a$ b
+print f"${n}${n + 1}"; // expect: 4243
+print f"${"a literal region"}"; // expect: a literal region
+print f"leading ${n}"; // expect: leading 42
+print f"${n} trailing"; // expect: 42 trailing
+print f"a${n}b${n}c"; // expect: a42b42c
+print f"null is ${null}"; // expect: null is null
+print f"bools ${true} ${false}"; // expect: bools true false
+print f"doubles ${1.5} ${0.1 + 0.2}"; // expect: doubles 1.5 0.3
+print f"array: ${[1, 2, 3]}"; // expect: array: [1, 2, 3]
+let m = {"key": "value"};
+print f"map: ${m}"; // expect: map: {key: value}
+print f"member: ${m["key"]}"; // expect: member: value
+let outer = f"outer ${f"inner ${1 + 1}"} rest";
+print outer; // expect: outer inner 2 rest
diff --git a/tests/e2e/tests/strings/fstring_escapes.ok b/tests/e2e/tests/strings/fstring_escapes.ok
new file mode 100644
index 0000000..b73e3af
--- /dev/null
+++ b/tests/e2e/tests/strings/fstring_escapes.ok
@@ -0,0 +1,17 @@
+// full escaping at string level only, never any lower layer's. the f lane
+// adds exactly one form to the set: `\${` writes the literal dollar-brace
+// (and a `\$` can only mean a plain dollar); everything else is the fixed
+// set plain strings already keep.
+print f"literal \${not a region}"; // expect: literal ${not a region}
+print f"escaped dollar \$5"; // expect: escaped dollar $5
+print f"tab\there"; // expect: tab	here
+print f"nl${1}"; // expect: nl1
+print len(f"a\nb"); // expect: 3
+print len(f"\t${1}"); // expect: 2
+print f"\u{1F600} ok"; // expect: 😀 ok
+print len(f"\u{1F600}!"); // expect: 2
+print f"quotes \" and ' inside"; // expect: quotes " and ' inside
+print f"back\\slash ${1}"; // expect: back\slash 1
+print f"\${1} is not an interpolation"; // expect: ${1} is not an interpolation
+let key = "k";
+print f"\$${key}"; // expect: $k
diff --git a/tests/e2e/tests/strings/fstring_nesting.ok b/tests/e2e/tests/strings/fstring_nesting.ok
new file mode 100644
index 0000000..f1b9212
--- /dev/null
+++ b/tests/e2e/tests/strings/fstring_nesting.ok
@@ -0,0 +1,20 @@
+// the nesting rulings: expressions nest with brace tracking, so quoted
+// strings inside interpolations work - a brace hidden in a region's string
+// never closes the region, braces nest (map literals), comments hide theirs
+// to the newline, and an f-string inside a region takes the whole ride one
+// level down.
+fu first(s) {
+    return s;
+}
+
+print f"${first("}")}abc"; // expect: }abc
+print f"${first('{')}"; // expect: {
+let m = {"a": 1};
+print f"map literal nests: ${ {"a": 1} }"; // expect: map literal nests: {a: 1}
+print f"subscript rides it: ${m["a"]}"; // expect: subscript rides it: 1
+print f"deep ${ f"a${ f"b${ 3 }c" }d" } e"; // expect: deep ab3cd e
+print fm"comment ${1 // a comment hides the brace on this line
++ 2} tail"; // expect: comment 3 tail
+print f"quotes either way: ${first(' "') }"; // expect: quotes either way:  "
+print f"${[1, [2, 3]]}"; // expect: [1, [2, 3]]
+print f"${ {"in": {"out": true}} }"; // expect: {in: {out: true}}
diff --git a/tests/e2e/tests/strings/mstring.ok b/tests/e2e/tests/strings/mstring.ok
new file mode 100644
index 0000000..8a78bf4
--- /dev/null
+++ b/tests/e2e/tests/strings/mstring.ok
@@ -0,0 +1,24 @@
+// the m"" ruling: same escape set as normal strings for predictability
+// (so `\$` stays refused - see errors/dollar_escape_refused.ok), literal
+// newlines, no dedent magic, either quote char. an m"" with no ${} in its
+// body is just a string that happens to hold newlines.
+let ml = m"line one
+line two";
+print ml; // expect: line one
+// expect: line two
+print len(ml); // expect: 17
+let indented = m"
+  no dedent magic
+";
+print len(indented); // expect: 19
+print m'also single
+quoted'; // expect: also single
+// expect: quoted
+print m"escapes\nride\tthe same set"; // expect: escapes
+// expect: ride	the same set
+print m"braces { } are literal bytes"; // expect: braces { } are literal bytes
+print m"dollars $ stay dollars"; // expect: dollars $ stay dollars
+let with_quote = m"a \"quoted\" word";
+print with_quote; // expect: a "quoted" word
+print m"\u{1F600}"; // expect: 😀
+print "after"; // expect: after
