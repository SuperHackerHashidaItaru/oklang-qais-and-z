diff --git a/tests/e2e/tests/regressions/assign_direct_binop_shapes.ok b/tests/e2e/tests/regressions/assign_direct_binop_shapes.ok
new file mode 100644
index 0000000..e1c7fe0
--- /dev/null
+++ b/tests/e2e/tests/regressions/assign_direct_binop_shapes.ok
@@ -0,0 +1,25 @@
+// the direct-into-local binop assignment and the shapes that must NOT take it.
+let mut a = 1;
+a = a + 1;
+print a;
+// expect: 2
+
+// left operand is not simple: the variable is re-read after the left side
+// evaluates, so this must keep the scratch path (and stay correct).
+a = (a + 1) + a;
+print a;
+// expect: 5
+
+// call on the left: same rule, the call may stage state in the destination.
+fu ten() {
+  return 10;
+}
+a = ten() + a;
+print a;
+// expect: 15
+
+// the destination appears on the right only: still one fused op, still correct.
+let mut b = 4;
+b = b * b;
+print b;
+// expect: 16
diff --git a/tests/e2e/tests/regressions/assign_operand_read_timing.ok b/tests/e2e/tests/regressions/assign_operand_read_timing.ok
new file mode 100644
index 0000000..2424e08
--- /dev/null
+++ b/tests/e2e/tests/regressions/assign_operand_read_timing.ok
@@ -0,0 +1,10 @@
+// binop operands are read at op time: a mutating call on the right side of
+// `a = a + f()` observes the mutation before the add (pinned behavior).
+let mut a = 1;
+let mutate = fu() {
+  a = 100;
+  return 5;
+};
+a = a + mutate();
+print a;
+// expect: 105
