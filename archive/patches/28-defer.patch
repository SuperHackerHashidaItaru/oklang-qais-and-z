+      error_at_noted(p_compiler,
+                     author,
+                     ok_create_string_view("spread ('...') is not allowed in a defer call.",
+                                           OK_STRING_VIEW_CALCULATE_LENGTH,
+                                           true),
+                     ok_create_string_view(
