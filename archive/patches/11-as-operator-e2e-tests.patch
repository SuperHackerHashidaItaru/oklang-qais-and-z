diff --git a/tests/e2e/tests/operators/as/precedence_shadow.ok b/tests/e2e/tests/operators/as/precedence_shadow.ok
new file mode 100644
index 0000000..9a2e73a
--- /dev/null
+++ b/tests/e2e/tests/operators/as/precedence_shadow.ok
@@ -0,0 +1,23 @@
+// `as` binds tighter than arithmetic (rust-style: between unary and product),
+// so conversions compose with + without parentheses.
+let i = 3;
+let n = 22;
+print i as str + " " + n as str; // expect: 3.000000 22.000000
+print n as num * 2; // expect: 44
+print 2 + 3 as num; // expect: 5
+
+// shadowing len keeps the ranged-for working (the loop reads the intrinsic).
+fu probe() {
+  let arr = [1, 2, 3];
+  let len = 22;
+  for let v : arr {
+    print v as str + " " + len as str;
+  }
+}
+probe(); // expect: 1.000000 22.000000
+// expect: 2.000000 22.000000
+// expect: 3.000000 22.000000
+
+// a plain let shadows the core name lexically, outside the loop too.
+let len = 67;
+print len; // expect: 67
diff --git a/tests/e2e/tests/operators/as/shadow_call_error.ok b/tests/e2e/tests/operators/as/shadow_call_error.ok
new file mode 100644
index 0000000..e5c6c9e
--- /dev/null
+++ b/tests/e2e/tests/operators/as/shadow_call_error.ok
@@ -0,0 +1,4 @@
+// a shadowed core name can no longer be called: the local value is not callable.
+let len = 67;
+let arr = [4, 5];
+print len(arr); // expect error: invalid call: value is not callable
diff --git a/tests/e2e/tests/operators/as/shadowed_tag_error.ok b/tests/e2e/tests/operators/as/shadowed_tag_error.ok
new file mode 100644
index 0000000..cd1def3
--- /dev/null
+++ b/tests/e2e/tests/operators/as/shadowed_tag_error.ok
@@ -0,0 +1,6 @@
+// a local shadowing a type tag is not a type anymore.
+fu shadowed_tag() {
+  let str = "hi";
+  print 1 as str; // expect error: invalid type: expected a type in 'as' conversion.
+}
+shadowed_tag();
