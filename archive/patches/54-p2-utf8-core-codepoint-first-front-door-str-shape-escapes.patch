+// the P2 index ruling: s[i] is the i-th CODEPOINT, a fresh one-codepoint
+// string - never the i-th byte. the s[s.len()-1] trap dies.
+let s = "héllo";
+print s[0]; // expect: h
+print s[1]; // expect: é
+print s[4]; // expect: o
+print len(s); // expect: 5
+print s.len(); // expect: 5
+
+// the last-codepoint idiom that used to be a byte trap
+let t = "noël";
+print t[t.len() - 1]; // expect: l
+print t[2]; // expect: ë
+
+// astral codepoints index as one
+let e = "😀";
+print e[0] == "😀"; // expect: true
+print len(e); // expect: 1
+
+// built-at-runtime strings ride the same lane
+let mut built = "";
+built += "é";
+built += "x";
+print built[0]; // expect: é
+print built[1]; // expect: x
+print len(built); // expect: 2
diff --git a/tests/e2e/tests/strings/iterate.ok b/tests/e2e/tests/strings/iterate.ok
new file mode 100644
index 0000000..ab39e76
--- /dev/null
+++ b/tests/e2e/tests/strings/iterate.ok
@@ -0,0 +1,55 @@
+// the P2 codepoint amendment: `for c in s` walks CODEPOINTS through the
+// str hidden shape (a utf8 byte cursor, one decode per step)
+let s = "héllo";
+let mut count = 0;
+for let c : s {
+  count += 1;
+}
+print count; // expect: 5
+
+// each c is a fresh one-codepoint string
+let mut second = "";
+let mut i = 0;
+for let c : "héllo" {
+  if i == 1 {
+    second = c;
+  }
+  i += 1;
+}
+print second; // expect: é
+print len(second); // expect: 1
+
+// ascii strings ride the same shape
+let mut built = "";
+for let c : "abc" {
+  built += c;
+}
+print built; // expect: abc
+
+// empty string: zero trips
+let mut trips = 0;
+for let c : "" {
+  trips += 1;
+}
+print trips; // expect: 0
+
+// 4-byte codepoints are one trip each
+let mut emoji = 0;
+for let c : "a😀b" {
+  emoji += 1;
+}
+print emoji; // expect: 3
+
+// conformance: the hidden shape and the manual index walk agree - the
+// contract the roadmap ruled ("observationally identical")
+let u = "αβγδ";
+let mut by_shape = "";
+for let c : u {
+  by_shape += c;
+}
+let mut by_index = "";
+for let k = 0 : len(u) {
+  by_index += u[k];
+}
+print by_shape == by_index; // expect: true
+print by_index; // expect: αβγδ
diff --git a/tests/e2e/tests/strings/len.ok b/tests/e2e/tests/strings/len.ok
new file mode 100644
index 0000000..cf33ab3
--- /dev/null
+++ b/tests/e2e/tests/strings/len.ok
@@ -0,0 +1,19 @@
+// the P2 len ruling: codepoints, not bytes. both counts live on the
+// interned header; len answers the codepoint one.
+print len("héllo"); // expect: 5
+print len(""); // expect: 0
+print len("abc"); // expect: 3
+print len("αβγδ"); // expect: 4
+print len("😀"); // expect: 1
+print len("a😀b"); // expect: 3
+// the method spelling agrees with the free one
+print "héllo".len(); // expect: 5
+// runtime-built strings cache the same way
+let mut s = "x";
+s += "é";
+s += "😀";
+print len(s); // expect: 3
+print s.len(); // expect: 3
+// len keeps its array and map lanes untouched
+print len([1, 2, 3]); // expect: 3
+print len({1: 2, 3: 4}); // expect: 2
