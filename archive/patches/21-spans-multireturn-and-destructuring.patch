+++ b/tests/e2e/tests/spans/null_results.ok
@@ -0,0 +1,15 @@
+// null is a legal result value, not a missing one
+fu find(arr, want) {
+  for let v : arr {
+    if v == want { return v, true; }
+  }
+  return null, false;
+}
+
+let (found, ok) = find([1, 2, 3], 2);
+print found; // expect: 2
+print ok; // expect: true
+
+let (missing, no) = find([1, 2, 3], 9);
+print missing; // expect: null
+print no; // expect: false
diff --git a/tests/e2e/tests/spans/results_in_loops.ok b/tests/e2e/tests/spans/results_in_loops.ok
new file mode 100644
index 0000000..9a501f4
--- /dev/null
+++ b/tests/e2e/tests/spans/results_in_loops.ok
@@ -0,0 +1,29 @@
+// span calls inside loop bodies, fresh bindings each trip. split(n)'s two
+// halves always sum back to n, so the trip prints n itself.
+fu split(n) {
+  let half = n / 2;
+  return half, n - half;
+}
+
+let mut n = 10;
+while n > 0 {
+  let (a, b) = split(n);
+  print a + b; // expect: 10
+                // expect: 9
+                // expect: 8
+                // expect: 7
+                // expect: 6
+                // expect: 5
+                // expect: 4
+                // expect: 3
+                // expect: 2
+                // expect: 1
+  n = n - 1;
+}
+
+for let i : [1, 2, 3] {
+  let (lo, hi) = split(i * 10);
+  print lo; // expect: 5
+            // expect: 10
+            // expect: 15
+}
