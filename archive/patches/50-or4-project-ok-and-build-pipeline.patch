+      p_sub != NULL ? ok_create_string_view(p_sub, (uint32_t)strlen(p_sub), true)
+                    : ok_create_string_view(".", 1, true);
+  char* base = join_normalize(p_a, p_dir, sub_view);
+  if (base == NULL) {
+    return NULL;
+  }
+  char* joined = join_normalize(p_a, base, p_rel);
+  mod_free(p_a, base);
+  return joined;
