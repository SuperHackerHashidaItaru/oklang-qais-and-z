+// ok.h's ok_set_projects: the borrowed graph moves in wholesale.
+void ok_modules_set_projects(module_system* p_modules,
+                             const ok_project* p_projects,
+                             uint32_t p_count,
+                             ok_project_build_hooks p_hooks) {
