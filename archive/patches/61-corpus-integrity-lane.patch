+// ------------------------------------------------------- the integrity pin
+
+// fnv1a64 over bytes: not cryptography, a tripwire. accidental mangling
+// (a U+FFFD replacement, an encoding flip) moves it essentially never.
+static uint64_t fnv1a64(const char* p_data, size_t p_length) {
+  uint64_t hash = 0xCBF29CE484222325ULL;
+  for (size_t i = 0; i < p_length; ++i) {
+    hash ^= (unsigned char)p_data[i];
+    hash *= 0x100000001B3ULL;
+  }
+  return hash;
+}
+
+// one checksums line: fnv1a64 <16 hex> <name>, name relative to the corpus
+// root (the walk's path, stripped). comment (#) and blank lines pass by.
+static const char* path_relative_to(const char* p_path, const char* p_root) {
+  const size_t root_len = strlen(p_root);
+  if (strncmp(p_path, p_root, root_len) == 0 && p_path[root_len] == '/') {
+    return p_path + root_len + 1;
+  }
+  return p_path;
+}
+
+static int hex_nibble(char p_c) {
+  if (p_c >= '0' && p_c <= '9') {
+    return p_c - '0';
+  }
+  if (p_c >= 'a' && p_c <= 'f') {
+    return p_c - 'a' + 10;
+  }
+  if (p_c >= 'A' && p_c <= 'F') {
+    return p_c - 'A' + 10;
+  }
+  return -1;
+}
+
+// verifies every seed the walk found against <dir>/checksums, when that
+// file exists (experimental --corpus dirs skip silently). three ways to
+// fail, all loud: a pinned seed's bytes moved, a pin naming a missing
+// seed, a walked seed nobody pinned. return 0 = the pins held.
+static int verify_checksums(const char* p_dir, const file_list* p_files) {
+  const size_t dir_len = strlen(p_dir);
+  char* pin_path = (char*)malloc(dir_len + sizeof("/checksums"));
+  if (pin_path == NULL) {
+    fprintf(stderr, "fuzz: out of memory building the pin path.\n");
+    exit(70);
+  }
+  memcpy(pin_path, p_dir, dir_len);
+  memcpy(pin_path + dir_len, "/checksums", sizeof("/checksums"));
+  size_t pins_length = 0;
+  char* pins = read_whole_file(pin_path, &pins_length);
+  free(pin_path);
+  if (pins == NULL) {
+    return 0; // no pins committed here - nothing to hold against
+  }
+
+  // one flag per walked file: every pin must land on exactly one.
+  bool* pinned = (bool*)calloc(p_files->count, sizeof(bool));
+  if (pinned == NULL && p_files->count > 0) {
+    fprintf(stderr, "fuzz: out of memory verifying pins.\n");
+    free(pins);
+    exit(70);
+  }
+
+  int held = 1;
+  char* cursor = pins;
+  while (*cursor != '\0') {
+    char* line = cursor;
+    char* newline = strchr(cursor, '\n');
+    if (newline != NULL) {
+      *newline = '\0';
+      cursor = newline + 1;
+    } else {
+      cursor = line + strlen(line);
+    }
+    if (line[0] == '#' || line[0] == '\0') {
+      continue;
+    }
+    if (strncmp(line, "fnv1a64 ", 8) != 0) {
+      fprintf(stderr, "fuzz: pin line not understood: \"%s\"\n", line);
+      held = 0;
+      continue;
+    }
+    uint64_t recorded = 0;
+    int nibble_ok = 1;
+    for (int i = 0; i < 16; ++i) {
+      const int nibble = hex_nibble(line[8 + i]);
+      if (nibble < 0) {
+        nibble_ok = 0;
+        break;
+      }
+      recorded = (recorded << 4) | (uint64_t)nibble;
+    }
+    const char* name = line + 24;
+    if (!nibble_ok || line[24] != ' ' || line[25] == '\0') {
+      fprintf(stderr, "fuzz: pin line not understood: \"%s\"\n", line);
+      held = 0;
+      continue;
+    }
+    name++;
+
+    uint32_t found = p_files->count;
+    for (uint32_t i = 0; i < p_files->count; ++i) {
+      if (strcmp(path_relative_to(p_files->files[i], p_dir), name) == 0) {
+        found = i;
+        break;
+      }
+    }
+    if (found == p_files->count) {
+      fprintf(stderr,
+              "fuzz: the pin names \"%s\" but the seed is not in the corpus.\n",
+              name);
+      held = 0;
+      continue;
+    }
+    pinned[found] = true;
+    size_t bytes_length = 0;
+    char* bytes = read_whole_file(p_files->files[found], &bytes_length);
+    if (bytes == NULL) {
+      fprintf(stderr, "fuzz: pinned seed \"%s\" cannot be read.\n", name);
+      held = 0;
+      continue;
+    }
+    const uint64_t actual = fnv1a64(bytes, bytes_length);
+    free(bytes);
+    if (actual != recorded) {
+      fprintf(stderr,
+              "fuzz: corpus seed \"%s\" fails its pin: recorded fnv1a64 %016llx, "
+              "bytes hash %016llx. binary seeds regenerate with: "
+              "bash tests/fuzz/corpus/gen.sh\n",
+              name,
+              (unsigned long long)recorded,
+              (unsigned long long)actual);
+      held = 0;
+    }
+  }
+
+  for (uint32_t i = 0; i < p_files->count; ++i) {
+    if (!pinned[i]) {
+      fprintf(stderr,
+              "fuzz: corpus seed \"%s\" has no pin - regenerate with "
+              "tests/fuzz/crosscheck.sh (manifest + checksums together).\n",
+              path_relative_to(p_files->files[i], p_dir));
+      held = 0;
+    }
+  }
+
+  free(pinned);
+  free(pins);
+  if (!held) {
+    fprintf(stderr, "fuzz: THE CORPUS MOVED - integrity pins did not hold.\n");
+  }
+  return held ? 0 : 70;
+}
+
+// the regen lane: prints the pins for every seed under p_dir (data lines
+// to stdout, the summary to stderr) - crosscheck.sh redirects this into
+// tests/fuzz/corpus/checksums.
+static int run_checksums(const char* p_dir) {
+  file_list files;
+  files.files = NULL;
+  files.count = 0;
+  files.capacity = 0;
+  walk(&files, p_dir);
+  if (files.count == 0) {
+    fprintf(stderr, "checksums: nothing to walk under \"%s\".\n", p_dir);
+    return 70;
+  }
+  for (uint32_t i = 0; i < files.count; ++i) {
+    size_t length = 0;
+    char* bytes = read_whole_file(files.files[i], &length);
+    if (bytes == NULL) {
+      fprintf(stderr, "checksums: cannot read \"%s\".\n", files.files[i]);
+      continue;
+    }
+    printf("fnv1a64 %016llx %s\n", (unsigned long long)fnv1a64(bytes, length),
+           path_relative_to(files.files[i], p_dir));
+    free(bytes);
+  }
+  for (uint32_t i = 0; i < files.count; ++i) {
+    free(files.files[i]);
+  }
+  free(files.files);
+  fprintf(stderr, "checksums: %u seeds pinned under \"%s\".\n", files.count, p_dir);
+  return 0;
+}
+
 // ---------------------------------------------------------------- the pipeline
 
 // the counters the summary line is made of.
@@ -358,6 +555,13 @@ static int run_fuzz(const char* p_corpus_dir, uint64_t p_iterations, uint64_t p_
     fprintf(stderr, "fuzz: no corpus under \"%s\" - the seeds are committed, they must be there.\n", p_corpus_dir);
     return 70;
