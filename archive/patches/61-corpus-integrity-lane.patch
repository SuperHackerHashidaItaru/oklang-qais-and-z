   uint64_t accepted = 0;
   uint64_t rejected = 0;
-  const size_t root_len = strlen(p_root);
   for (uint32_t i = 0; i < files.count; ++i) {
     ok* instance = make_instance();
     size_t length = 0;
@@ -466,10 +676,7 @@ static int run_crosscheck(const char* p_root) {
