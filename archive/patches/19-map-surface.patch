+  if (!IS_VALUE_MAP(p_map) || IS_VALUE_STRICTLY_NULL(p_key) || !map_key_is_legal(p_key)) {
+    return false;
+  }
+  value* slot = value_map_get(&VALUE_AS_MAP(p_map)->entries, p_key);
+  if (slot == NULL) {
+    return false;
+  }
+  *p_out = *slot;
+  return true;
