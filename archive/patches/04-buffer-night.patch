diff --git a/tests/e2e/tests/operators/ternary/nesting.ok b/tests/e2e/tests/operators/ternary/nesting.ok
new file mode 100644
index 0000000..5869518
--- /dev/null
+++ b/tests/e2e/tests/operators/ternary/nesting.ok
@@ -0,0 +1,19 @@
+// right associativity: a then b otherwise c then d otherwise e
+// parses as a then b otherwise (c then d otherwise e)
+let n = 2;
+print(n == 1 then "one" otherwise n == 2 then "two" otherwise "many"); // expect: two
+let m = 7;
+print(m == 1 then "one" otherwise m == 2 then "two" otherwise "many"); // expect: many
+let k = 1;
+print(k == 1 then "one" otherwise k == 2 then "two" otherwise "many"); // expect: one
+// nested in the then arm needs no parens (arm stops at otherwise)
+print(true then (false then 1 otherwise 2) otherwise 3); // expect: 2
+print(false then 1 otherwise (true then 4 otherwise 5)); // expect: 4
+// chained comparisons pick the first match
+fu grade(s) {
+  return s >= 90 then "a" otherwise s >= 80 then "b" otherwise s >= 70 then "c" otherwise "f";
+}
+print(grade(95)); // expect: a
+print(grade(85)); // expect: b
+print(grade(72)); // expect: c
+print(grade(10)); // expect: f
diff --git a/tests/e2e/tests/operators/ternary/side_effects.ok b/tests/e2e/tests/operators/ternary/side_effects.ok
new file mode 100644
index 0000000..1b30eb6
--- /dev/null
+++ b/tests/e2e/tests/operators/ternary/side_effects.ok
@@ -0,0 +1,22 @@
+// only the taken arm runs
+let mut calls = 0;
+fu th() { calls += 1; return 10; }
+fu ot() { calls += 1; return 20; }
+print(true then th() otherwise ot()); // expect: 10
+print(calls); // expect: 1
+print(false then th() otherwise ot()); // expect: 20
+print(calls); // expect: 2
+// the condition evaluates exactly once, before either arm
+let mut order = 0;
+fu cond() { order = order * 10 + 1; return true; }
+fu a1() { order = order * 10 + 2; return 0; }
+fu b1() { order = order * 10 + 3; return 0; }
+print(cond() then a1() otherwise b1()); // expect: 0
+print(order); // expect: 12
+// arms inside loops keep working across iterations (modulo parses but has no
+// opcode yet — pre-existing gap, not ternary; parity via or-chain instead)
+let mut sum = 0;
+for let i = 0 : 6? {
+  sum += (i == 0 or i == 2 or i == 4) then i otherwise 0 - i;
+}
+print(sum); // expect: -3
diff --git a/tests/e2e/tests/operators/ternary/terminator.ok b/tests/e2e/tests/operators/ternary/terminator.ok
new file mode 100644
index 0000000..7c989a8
--- /dev/null
+++ b/tests/e2e/tests/operators/ternary/terminator.ok
@@ -0,0 +1,15 @@
+// the conditional in statement position: the value is discarded, both arms compile
+true then 1 otherwise 2;
+false then 1 otherwise 2;
+print("done"); // expect: done
+// in a condition position, where the ? terminator applies: the condition is
+// the ternary's RESULT, so use boolean-valued arms to steer the branch
+if true then false otherwise true ? { print("a"); } else { print("b"); } // expect: b
+if false then false otherwise true ? { print("a"); } else { print("b"); } // expect: a
+if false then true otherwise false ? { print("a"); } else { print("b"); } // expect: b
+if true then true otherwise false ? { print("a"); } else { print("b"); } // expect: a
+// a number-valued ternary condition follows the truthiness doctrine
+if false then 1 otherwise 2 ? { print("n"); } else { print("z"); } // expect: n
+let mut x = 0;
+while x < (true then 2 otherwise 99) ? { x += 1; }
+print(x); // expect: 2
diff --git a/tests/e2e/tests/strings/concat.ok b/tests/e2e/tests/strings/concat.ok
new file mode 100644
index 0000000..a23b9ea
--- /dev/null
+++ b/tests/e2e/tests/strings/concat.ok
@@ -0,0 +1,34 @@
+print("a" + "b"); // expect: ab
+print("foo" + "" + "bar"); // expect: foobar
+print(("" + "") == ""); // expect: true
+let mut s = "x";
+s += "y";
+print(s); // expect: xy
+s = s + "!" + "?";
+print(s); // expect: xy!?
+// concat produces fresh strings: the operands are untouched
+let a = "left";
+let b = "right";
+let c = a + b;
+print(a); // expect: left
+print(b); // expect: right
+print(c); // expect: leftright
+// runtime-built strings work the same as literals
+let mut built = "";
+for let i = 0 : 3? {
+  built += "ab";
+}
+print(built == "ababab"); // expect: true
+print(built + "!"); // expect: ababab!
+// inside larger expressions
+print("n = " + "42"); // expect: n = 42
+print(("a" + "b") == "ab"); // expect: true
+// strings as array elements, concat reads them back
+let arr = ["x", "y", "z"];
+print(arr[0] + arr[2]); // expect: xz
+// compound assign on an array element
+let mut words = ["con", "cat"];
+words[0] += words[1];
+print(words[0]); // expect: concat
+// string in a conditional arm
+print(true then "yes" + "!" otherwise "no"); // expect: yes!
diff --git a/tests/e2e/tests/strings/equality.ok b/tests/e2e/tests/strings/equality.ok
new file mode 100644
index 0000000..e133e92
--- /dev/null
+++ b/tests/e2e/tests/strings/equality.ok
@@ -0,0 +1,22 @@
+print("ab" == "ab"); // expect: true
+print("ab" == "abc"); // expect: false
+print("abc" == "ab"); // expect: false
+print("" == ""); // expect: true
+print("ab" != "ab"); // expect: false
+print("ab" != "abc"); // expect: true
+// equal content built at runtime compares equal (value semantics, not identity)
+print(("a" + "b") == "ab"); // expect: true
+print(("a" + "b") != "ac"); // expect: true
+let mut grown = "ab";
+grown += "c";
+print(grown == "abc"); // expect: true
+print(grown == "ab"); // expect: false
+// strings do not equal numbers or null (mixed equality stays identity)
+print("1" == 1); // expect: false
+print("" == null); // expect: false
+print("null" == null); // expect: false
+// in conditions
+if "ab" == "ab" ? { print("eq"); } else { print("ne"); } // expect: eq
+if "ab" == "abc" ? { print("eq"); } else { print("ne"); } // expect: ne
+let pick = "x" == "x" then 1 otherwise 2;
+print(pick); // expect: 1
