index 0000000..43d3923
--- /dev/null
+++ b/tests/e2e/tests/arrays/regressions/eval_order.ok
@@ -0,0 +1,25 @@
+// evaluation order for subscript assignment: base, then index, then rhs.
+// observable through a shared counter the probes multiply into.
+let mut order = 0;
+fu base() { order = order * 10 + 1; return [0, 0]; }
+fu index() { order = order * 10 + 2; return 1; }
+fu value() { order = order * 10 + 3; return 77; }
+let slot = base();
+slot[index()] = value();
+print(order); // expect: 123
+print(slot[1]); // expect: 77
+// compound: base, index, current read, rhs — f exactly once, g after
+let mut order2 = 0;
+fu f() { order2 = order2 * 10 + 1; return 0; }
+fu g() { order2 = order2 * 10 + 2; return 7; }
+let mut c = [0, 0];
+c[f()] += g();
+print(order2); // expect: 12
+print(c[0]); // expect: 7
+// reading: base then index
+let mut order3 = 0;
+fu rb() { order3 = order3 * 10 + 1; return [[5, 6], [7, 8]]; }
+fu ri() { order3 = order3 * 10 + 2; return 1; }
+let grid = rb();
+print(grid[ri()][1]); // expect: 8
+print(order3); // expect: 12
diff --git a/tests/e2e/tests/control/truthiness.ok b/tests/e2e/tests/control/truthiness.ok
new file mode 100644
index 0000000..cb39314
--- /dev/null
+++ b/tests/e2e/tests/control/truthiness.ok
@@ -0,0 +1,25 @@
+// falsy is exactly: false and null. everything else is truthy (0, "", arrays).
+print(0 then "t" otherwise "f"); // expect: t
+print(0.0 then "t" otherwise "f"); // expect: t
+print("" then "t" otherwise "f"); // expect: t
+print([1] then "t" otherwise "f"); // expect: t
+print([] then "t" otherwise "f"); // expect: t
+print(null then "t" otherwise "f"); // expect: f
+print(false then "t" otherwise "f"); // expect: f
+// same doctrine through if (pins is_falsy in both directions)
+if 0 ? { print("a"); } else { print("b"); } // expect: a
+if "" ? { print("a"); } else { print("b"); } // expect: a
+if [] ? { print("a"); } else { print("b"); } // expect: a
+if null ? { print("a"); } else { print("b"); } // expect: b
+// and through while
+let mut n = 0;
+while n < 3 ? { n += 1; }
+print(n); // expect: 3
+// through and/or (value semantics, short circuit)
+print(null and 1); // expect: null
+print(false and 1); // expect: false
+print(0 and 1); // expect: 1
+print(1 and null); // expect: null
+print(1 or null); // expect: 1
+print(null or 0); // expect: 0
+print((false or "") == ""); // expect: true
diff --git a/tests/e2e/tests/operators/logical.ok b/tests/e2e/tests/operators/logical.ok
new file mode 100644
index 0000000..392d967
--- /dev/null
+++ b/tests/e2e/tests/operators/logical.ok
@@ -0,0 +1,46 @@
+// and/or are short-circuit VALUE operators (lua style): they return one of
+// their operands, not a boolean, and the right side only runs when needed.
+print(true and true); // expect: true
+print(true and false); // expect: false
+print(false and true); // expect: false
+print(false and false); // expect: false
+print(true or true); // expect: true
+print(true or false); // expect: true
+print(false or true); // expect: true
+print(false or false); // expect: false
+// value semantics: the returned value is the deciding operand
+print(1 and 2); // expect: 2
+print(0 and 2); // expect: 2
+print(null and 2); // expect: null
+print(false and 2); // expect: false
+print(1 or 2); // expect: 1
+print(null or 2); // expect: 2
+print(false or 2); // expect: 2
+// short circuit: the right side must not run
+let mut runs = 0;
+fu bump(v) { runs += 1; return v; }
+print(false and bump(1)); // expect: false
+print(runs); // expect: 0
+print(true or bump(1)); // expect: true
+print(runs); // expect: 0
+print(true and bump(5)); // expect: 5
+print(runs); // expect: 1
+print(false or bump(6)); // expect: 6
+print(runs); // expect: 2
+// the classic guard: safe when x is null
+fu clamp(x) { return x != null and x > 0 then x otherwise 0; }
+print(clamp(5)); // expect: 5
+print(clamp(-5)); // expect: 0
+print(clamp(null)); // expect: 0
+// precedence: not > and > or, comparison binds tighter than both
+print(not true and false); // expect: false
+print(not (true and false)); // expect: true
+print(true or false and false); // expect: true
+print((true or false) and false); // expect: false
+print(1 < 2 and 2 < 3); // expect: true
+print(1 > 2 or 2 > 3); // expect: false
+// chains
+print(1 and 2 and 3); // expect: 3
+print(null and 2 and 3); // expect: null
+// 0 is truthy, so the chain stops at 0
+print(null or 0 or 7); // expect: 0
diff --git a/tests/e2e/tests/operators/ternary/arms.ok b/tests/e2e/tests/operators/ternary/arms.ok
new file mode 100644
index 0000000..4c80d38
--- /dev/null
+++ b/tests/e2e/tests/operators/ternary/arms.ok
@@ -0,0 +1,39 @@
+// assignment arms need parentheses (then arm stops at `=` otherwise)
+let mut y = 0;
+print(true then (y = 5) otherwise (y = 6)); // expect: 5
+print(y); // expect: 5
+print(false then (y = 7) otherwise (y = 8)); // expect: 8
+print(y); // expect: 8
+// compound-assign arm
+let mut z = 1;
+print(true then (z += 10) otherwise (z += 100)); // expect: 11
+print(z); // expect: 11
+// the conditional's value is the assignment's value
+let mut w = 0;
+let r = true then (w = 42) otherwise (w = 43);
+print(r); // expect: 42
+print(w); // expect: 42
+// as a call argument
+fu add(a, b) { return a + b; }
+print(add(true then 10 otherwise 20, false then 100 otherwise 200)); // expect: 210
+// as a subscript index and inside subscripts
+let arr = [10, 20, 30, 40];
+print(arr[true then 0 otherwise 3]); // expect: 10
+print(arr[1 + (false then 0 otherwise 2)]); // expect: 40
+print(arr[true then 1 otherwise 2] + arr[false then 1 otherwise 2]); // expect: 50
+// in a while condition and body
+let mut i = 0;
+let mut seen = 0;
+while (i < 4) ? {
+  seen = seen * 10 + (i > 2 then 9 otherwise 1);
+  i += 1;
+}
+print(seen); // expect: 1119
+// closures as arms: both arms compile, only one closes over nothing harmful
+fu make(flag) { return flag then fu() { return 1; } otherwise fu() { return 2; }; }
+print(make(true)()); // expect: 1
+print(make(false)()); // expect: 2
+// conditional result is not an lvalue (assignment to it must fail to compile is
+// covered by errors/; here we only chain reads)
+let v = (true then 1 otherwise 2) + (false then 10 otherwise 20);
+print(v); // expect: 21
