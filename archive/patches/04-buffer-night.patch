diff --git a/tests/e2e/tests/arrays/regressions/assign_call_rhs_window.ok b/tests/e2e/tests/arrays/regressions/assign_call_rhs_window.ok
new file mode 100644
index 0000000..d8a861d
--- /dev/null
+++ b/tests/e2e/tests/arrays/regressions/assign_call_rhs_window.ok
@@ -0,0 +1,33 @@
+// regression: a call on the rhs of a subscript assignment opens the callee's
+// register window at the rhs destination; the callee's frame null-fills every
+// slot above it. when the rhs compiled into p_dest (below the lvalue's staged
+// base/index temps), the callee erased the staging: arr[0] = reseat() died with
+// "expected an array" the moment reseat had enough registers to reach up.
+// the fix compiles the rhs into a temp above the staging. compound assigns
+// were always safe (their cur/rhs temps allocate after the staging).
+let mut arr = [1, 2];
+let alias = arr;
+fu reseat() { arr = [9, 9]; return 3; }
+arr[0] = reseat();
+print(alias[0]); // expect: 3
+print(arr[0]); // expect: 9
+// small callees (1 register) never reached the staging, but large ones do:
+fu wide() {
+  let a = 1; let b = 2; let c = 3; let d = 4;
+  let e = [a, b, c, d];
+  return e[0] + e[3];
+}
+let mut nums = [0, 0];
+nums[1] = wide();
+print(nums[0]); // expect: 0
+print(nums[1]); // expect: 5
+// nested: subscript assign as the rhs of another subscript assign
+let mut outer = [[0, 0], [0, 0]];
+outer[0][1] = (outer[1][0] = 7);
+print(outer[0][1]); // expect: 7
+print(outer[1][0]); // expect: 7
+// globals as containers
+glob let mut g = [1, 2];
+fu greseat() { g = [8, 8]; return 4; }
+g[0] = greseat();
+print(g[0]); // expect: 8
diff --git a/tests/e2e/tests/arrays/regressions/container_elision_gates.ok b/tests/e2e/tests/arrays/regressions/container_elision_gates.ok
new file mode 100644
index 0000000..50a3da6
--- /dev/null
+++ b/tests/e2e/tests/arrays/regressions/container_elision_gates.ok
@@ -0,0 +1,41 @@
+// the container-elision gates: when the container is a plain local, subscript
+// reads and writes reference the local's register directly (no staging move)
+// only when nothing between resolve and use can reseat it. these pin the
+// corners where staging MUST stay, so the elision can never change semantics.
+// rhs assignment reseats the container: the store goes to the ORIGINAL array
+let mut a = [1, 2];
+let b = a;
+a[0] = (a = 5);
+print(b[0]); // expect: 5
+print(a); // expect: 5
+// a call in the rhs may mutate a captured container: store still hits the original
+let mut arr = [1, 2];
+let alias = arr;
+fu reseat() { arr = [9, 9]; return 3; }
+arr[0] = reseat();
+print(alias[0]); // expect: 3
+print(arr[0]); // expect: 9
+// a call in the INDEX may reseat the container: staged base survives
+let mut d = [1, 2];
+let dalias = d;
+fu idx() { d = [8, 8]; return 0; }
+d[idx()] = 42;
+print(dalias[0]); // expect: 42
+print(dalias[1]); // expect: 2
+print(d[0]); // expect: 8
+// inert indexes and rhs values: elision fires, results identical
+let mut n = [10, 20, 30];
+let i = 2;
+n[i] = n[i] + 5;
+print(n[2]); // expect: 35
+n[0] += n[1];
+print(n[0]); // expect: 30
+// nested subscript reads inside the rhs of a subscript write
+let m = [[1, 2], [3, 4]];
+let mut out = [0, 0];
+out[0] = m[1][0] + m[0][1];
+print(out[0]); // expect: 5
+// lambda literal in the rhs is inert (creating a closure runs no body)
+let mut fs = [null, null];
+fs[0] = fu() { return 99; };
+print(fs[0]()); // expect: 99
diff --git a/tests/e2e/tests/arrays/regressions/eval_order.ok b/tests/e2e/tests/arrays/regressions/eval_order.ok
