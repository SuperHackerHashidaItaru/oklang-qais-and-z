diff --git a/src/okdiag.c b/src/okdiag.c
new file mode 100644
index 0000000..0f81b65
--- /dev/null
+++ b/src/okdiag.c
@@ -0,0 +1,172 @@
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "okdiag.h"
+
+// the source line containing p_offset. returns the line's bounds and, through
+// p_column, the 1-based column of p_offset within it (byte = char for now,
+// tab = one column, see okdiag_column_of — the whole utf8 story is one
+// function away by design).
+static void line_bounds_of(const char* p_source,
+                           const ok_span* p_span,
+                           uint32_t* p_line_start,
+                           uint32_t* p_line_end,
+                           uint32_t* p_column) {
+  uint32_t line_start = p_span->offset;
+  while (line_start > 0 && p_source[line_start - 1] != '\n') {
+    line_start--;
+  }
+  uint32_t line_end = p_span->offset;
+  while (p_source[line_end] != '\0' && p_source[line_end] != '\n') {
+    line_end++;
+  }
+  *p_line_start = line_start;
+  *p_line_end = line_end;
+  *p_column = p_span->offset - line_start + 1;
+}
+
+uint32_t okdiag_column_of(const char* p_source, uint32_t p_offset) {
+  uint32_t column = 1;
+  while (p_offset > 0 && p_source[p_offset - 1] != '\n') {
+    p_offset--;
+    column++;
+  }
+  return column;
+}
+
+ok_span ok_span_of_token(const token* p_token) {
+  ok_span span;
+  span.line = p_token->line_info.line;
+  span.offset = p_token->line_info.offset;
+  // TOKEN_ERROR's .start is the message (create_error_token), not source: the
+  // old renderer printed the message as if it were the line. one caret on the
+  // offending byte instead — the offset is already right.
+  span.length = p_token->type == TOKEN_ERROR ? 1 : p_token->length;
+  return span;
+}
+
+void okdiag_print_header(const char* p_path, uint32_t p_line, uint32_t p_column, const char* p_kind, const char* p_text) {
+  fprintf(stderr, "%s:%u:%u: %s: %s", p_path, p_line, p_column, p_kind, p_text);
+}
+
+// `    NNN | the source line` + `        | ^~~~~`
+// p_width is the shared line-number gutter width so a diagnostic and its
+// notes align. returns false on printf failure (the caller folds it into the
+// report status).
+static bool print_snippet(const char* p_source, const ok_span* p_span, uint32_t p_width) {
+  uint32_t line_start = 0;
+  uint32_t line_end = 0;
+  uint32_t column = 0;
+  line_bounds_of(p_source, p_span, &line_start, &line_end, &column);
+  if (fprintf(stderr, "    %*u | ", (int)p_width, p_span->line) < 0) {
+    return false;
+  }
+  if (fwrite(p_source + line_start, 1, line_end - line_start, stderr) < line_end - line_start) {
+    return false;
+  }
+  if (fputc('\n', stderr) == EOF) {
+    return false;
+  }
+  if (fprintf(stderr, "    %*s | ", (int)p_width, "") < 0) {
+    return false;
+  }
+  for (uint32_t i = 1; i < column; ++i) {
+    if (fputc(' ', stderr) == EOF) {
+      return false;
+    }
+  }
+  // the caret underlines the span's full length, clamped to the line, min one
+  uint32_t carets = p_span->length;
+  if (carets > line_end - p_span->offset) {
+    carets = line_end - p_span->offset;
+  }
+  if (carets == 0) {
+    carets = 1;
+  }
+  for (uint32_t i = 0; i < carets; ++i) {
+    if (fputc('^', stderr) == EOF) {
+      return false;
+    }
+  }
+  return fputc('\n', stderr) != EOF;
+}
+
+static uint32_t digits_of(uint32_t p_value) {
+  uint32_t digits = 1;
+  while (p_value >= 10) {
+    p_value /= 10;
+    digits++;
+  }
+  return digits;
+}
+
+report_status okdiag_report(bool* p_panic,
+                            bool* p_had_error,
+                            const char* p_path,
+                            const char* p_source,
+                            const ok_span* p_span,
+                            bool p_is_eof,
+                            report_severity p_severity,
+                            const ok_string_view p_message,
+                            const ok_note* p_note) {
+  if (*p_panic) {
+    return REPORT_STATUS_SKIPPED;
+  }
+  bool printf_fail = false;
+  *p_panic = true;
+  *p_had_error = true;
+  const char* kind = p_severity == REPORT_SEVERITY_WARN ? "warning" : "error";
+
+  // a real span always has line >= 1. no span (or no source text to excerpt
+  // from): the message still prints, degraded but never wrong.
+  const ok_span* span = p_span != NULL && p_span->line > 0 ? p_span : NULL;
+  if (p_source == NULL) {
+    span = NULL;
+  }
+
+  uint32_t width = 1;
+  if (span != NULL) {
+    width = digits_of(span->line);
+  }
+  if (p_note != NULL && p_note->has_span && p_source != NULL) {
+    const uint32_t note_width = digits_of(p_note->span.line);
+    if (note_width > width) {
+      width = note_width;
+    }
+  }
+
+  // header. EOF spans point one past the last byte and say so, on the message
+  // line (gcc's placement), instead of rendering nothing. no span: bare
+  // `error: message`, like the old no-location runtime path.
+  if (span != NULL) {
+    const uint32_t column = okdiag_column_of(p_source, span->offset);
+    printf_fail |= fprintf(stderr, "%s:%u:%u: %s: %.*s", p_path, span->line, column, kind,
+                           (int)ok_string_view_get_length(&p_message), p_message.chars) < 0;
+  } else {
+    printf_fail |= fprintf(stderr, "%s: %.*s", kind, (int)ok_string_view_get_length(&p_message), p_message.chars) < 0;
+  }
+  if (p_is_eof) {
+    printf_fail |= fprintf(stderr, " (at end of file)") < 0;
+  }
+  printf_fail |= fputc('\n', stderr) == EOF;
+
+  // snippet
+  if (span != NULL) {
+    printf_fail |= !print_snippet(p_source, span, width);
+  }
+
+  // note
+  if (p_note != NULL && p_note->text.chars != NULL) {
+    if (p_note->has_span && p_source != NULL) {
+      const uint32_t note_column = okdiag_column_of(p_source, p_note->span.offset);
+      printf_fail |= fprintf(stderr, "%s:%u:%u: note: %.*s\n", p_path, p_note->span.line, note_column,
+                             (int)ok_string_view_get_length(&p_note->text), p_note->text.chars) < 0;
+      printf_fail |= !print_snippet(p_source, &p_note->span, width);
+    } else {
+      printf_fail |= fprintf(stderr, "    %*s | note: %.*s\n", (int)width, "",
+                             (int)ok_string_view_get_length(&p_note->text), p_note->text.chars) < 0;
+    }
+  }
+  return printf_fail ? REPORT_STATUS_FAILED : REPORT_STATUS_OK;
+}
diff --git a/src/okdiag.h b/src/okdiag.h
new file mode 100644
index 0000000..63df7ae
--- /dev/null
+++ b/src/okdiag.h
@@ -0,0 +1,70 @@
+#ifndef OK_DIAG_H
+#define OK_DIAG_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "ok/ok_source.h"
+#include "okstring.h"
+#include "oktoken.h"
+
+// the diagnostics renderer. parse errors, compile errors and runtime reports
+// all print through here (gcc-parseable `path:line:col:` headers plus a
+// rustc-style source snippet), so the format is a contract, not an accident.
+
+typedef enum {
+  REPORT_SEVERITY_WARN,
+  REPORT_SEVERITY_ERROR,
+} report_severity;
+
+typedef enum {
+  REPORT_STATUS_OK,
+  REPORT_STATUS_FAILED,
+  REPORT_STATUS_SKIPPED,
+} report_status;
+
+// a byte span into the source. computed by pointer arithmetic at token
+// creation, never by an accumulated counter — that was the old R1 bug.
+typedef struct {
+  uint32_t line;   // 1-based, straight from the lexer's line counter
+  uint32_t offset; // file-absolute byte offset of the span start
+  uint32_t length; // span length in bytes; 0 renders one caret (EOF)
+} ok_span;
+
+// a note with an optional location: text alone renders as today's notes
+// (`    | note: text`), text + span renders a full secondary diagnostic with
+// its own header and snippet ("note: previously declared here").
+typedef struct {
+  ok_string_view text;
+  bool has_span;
+  ok_span span;
+} ok_note;
+
+// the span of a token. TOKEN_ERROR tokens carry the message in .start (the
+// parser reads it from there), so their span length is forced to the single
+// offending byte instead of the message's length.
+ok_span ok_span_of_token(const token* p_token);
+
+// THE one function the 0.8.0 utf8 pass revisits. byte = char for now: a tab
+// counts as one column and renders raw — the caret aligns to the raw text,
+// which is the only thing that stays true on every terminal.
+uint32_t okdiag_column_of(const char* p_source, uint32_t p_offset);
+
+// renders one diagnostic. p_source may be NULL (or p_span): header-only,
+// degraded but never wrong. p_note may be NULL. first error wins: *p_panic
+// gates (REPORT_STATUS_SKIPPED), matching the v1 panic-mode ruling.
+report_status okdiag_report(bool* p_panic,
+                            bool* p_had_error,
+                            const char* p_path,
+                            const char* p_source,
+                            const ok_span* p_span,
+                            bool p_is_eof,
+                            report_severity p_severity,
+                            const ok_string_view p_message,
+                            const ok_note* p_note);
+
+// the (path, line, column) header every diagnostic starts with, exposed for
+// the runtime report's stack trace lines.
+void okdiag_print_header(const char* p_path, uint32_t p_line, uint32_t p_column, const char* p_kind, const char* p_text);
+
+#endif // OK_DIAG_H
