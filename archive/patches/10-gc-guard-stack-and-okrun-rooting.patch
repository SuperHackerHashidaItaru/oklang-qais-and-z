   }
-  if (!mark_value(p_gc, p_gc->guarded)) {
-    return false;
+  for (uint32_t i = 0; i < p_gc->guard_count; ++i) {
+    if (!mark_value(p_gc, p_gc->guarded[i])) {
+      return false;
+    }
   }
   return true;
 }
diff --git a/src/okgc.h b/src/okgc.h
index b922c30..f56eae3 100644
--- a/src/okgc.h
+++ b/src/okgc.h
@@ -10,6 +10,12 @@
 #ifdef OK_GC_EXPOSE
 #include "okarray.h"
 ARRAY_DECLARE_DEFAULT(grays, object*)
+// guards are a stack, not a slot: pairs at different call depths must compose.
+// with a single value, a nested up silently fails and the inner down releases
+// the outer guard early (found via OK_AGGRESSIVE_GC: ok_run's function guard
+// colliding with vm_interpret's; the compile-phase pairs survive only by
+// being carefully sequential).
+#define OK_GC_GUARD_CAPACITY 16
 struct gc {
   size_t allocated_bytes;
   size_t next;
@@ -18,7 +24,8 @@ struct gc {
   object_store* object_store;
   globals_store* globals_store;
   grays grays;
-  value guarded;
+  value guarded[OK_GC_GUARD_CAPACITY];
+  uint32_t guard_count;
   allocators* alloc;
   allocators raw_alloc_wrapper;
   bool is_paused;
